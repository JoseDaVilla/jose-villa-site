---
// Flat twin of the hero's 3D app window (src/scripts/hero-scene.ts), drawn in
// the same 400x320 frame. Used as the hero poster and by the intro, which
// animates its parts through the am-* classes.
interface Props { class?: string }
const { class: className } = Astro.props;
const bars = [33, 51, 81, 57, 72];
const line = '#D9CFC1';
---
<svg class={className} viewBox="0 0 400 320" focusable="false" aria-hidden="true">
  <g stroke="var(--ink)" stroke-linejoin="round">
    <circle class="am-blob am-blob-1" cx="53" cy="64" r="14" fill="var(--sky)" stroke-width="4" />

    <g class="am-win">
      <rect class="am-frame" x="62" y="64" width="276" height="192" rx="20" fill="var(--paper, #FFFDF8)" stroke-width="5" pathLength="1" />
      <g class="am-ui" stroke="none">
        <rect x="70" y="72" width="260" height="26" rx="10" fill="var(--bg)" />
        <rect x="76" y="108" width="54" height="138" rx="9" fill="var(--sky)" />
        {[122, 142, 162, 182].map((y) => <rect x="83" y={y} width="30" height="6" rx="3" fill="var(--paper, #FFFDF8)" />)}
        <rect x="145" y="118" width="102" height="10" rx="5" fill="var(--ink)" />
        <rect x="145" y="136" width="70" height="7" rx="3.5" fill={line} />
        <rect x="150" y="236" width="145" height="3" rx="1.5" fill={line} />
      </g>
      <g class="am-dots" stroke-width="2.5">
        <circle cx="85" cy="85" r="5.5" fill="var(--orange)" />
        <circle cx="102" cy="85" r="5.5" fill="var(--sun)" />
        <circle cx="119" cy="85" r="5.5" fill="var(--leaf)" />
      </g>
      <g class="am-bars" stroke="none">
        {bars.map((h, i) => (
          <rect style={`--i: ${i}`} x={157 + i * 28} y={236 - h} width="18" height={h} rx="5" fill={i === 2 ? 'var(--orange)' : 'var(--blue)'} />
        ))}
      </g>
    </g>

    <circle class="am-blob am-blob-2" cx="353" cy="247" r="22" fill="var(--orange)" stroke-width="4" />

    <g class="am-receipt">
      <rect x="40" y="186" width="69" height="93" rx="10" fill="var(--paper, #FFFDF8)" stroke-width="4" />
      <g stroke="none" fill={line}>
        <rect x="52" y="200" width="45" height="5" rx="2.5" />
        <rect x="52" y="214" width="33" height="5" rx="2.5" />
        <rect x="52" y="228" width="45" height="5" rx="2.5" />
      </g>
      <rect x="50" y="250" width="49" height="16" rx="6" fill="var(--sun)" stroke="none" />
    </g>

    <g class="am-lead">
      <rect x="251" y="60" width="120" height="50" rx="14" fill="var(--paper, #FFFDF8)" stroke-width="4" />
      <circle cx="274" cy="85" r="13" fill="var(--leaf)" stroke-width="3" />
      <rect x="293" y="75" width="48" height="7" rx="3.5" fill="var(--ink)" stroke="none" />
      <rect x="293" y="89" width="33" height="5" rx="2.5" fill={line} stroke="none" />
      <g class="am-check">
        <circle cx="354" cy="85" r="12" fill="var(--leaf)" stroke-width="3" />
        <path d="M348.5 85.5 l3.8 3.8 l7.4 -7.6" fill="none" stroke-width="3" stroke-linecap="round" pathLength="1" />
      </g>
    </g>
  </g>
</svg>
