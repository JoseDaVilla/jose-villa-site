---
import { blobPath } from '../lib/shapes';
import Waves from './Waves.astro';
import { site } from '../data/site';

const topics = ['Product build', 'Tech leadership', 'Automation', 'Just saying hi'];
---
<section id="contact" class="contact" aria-labelledby="contact-title">
  <Waves
    seed={51}
    layers={[
      { fill: 'var(--sky)', base: 44, amp: 20 },
      { fill: 'var(--leaf)', base: 78, amp: 18 },
      { fill: 'var(--surface)', base: 110, amp: 12, steps: 7 },
    ]}
  />
  <div class="contact-in">
    <div class="container grid">
      <div class="intro">
        <h2 id="contact-title">Let's build something that runs your business.</h2>
        <p>
          I'm taking on a small number of new engagements: product builds, technical leadership,
          or process automation. Send a note and I'll reply within a day or two.
        </p>
        <div class="direct">
          <p>Or email me directly</p>
          <div class="email-row">
            <a href={`mailto:${site.email}`}>{site.email}</a>
            <button type="button" class="copy" data-copy={site.email}>Copy</button>
          </div>
        </div>
        <div class="scene" aria-hidden="true">
          <svg class="art" viewBox="0 0 400 300" focusable="false">
            <path d={blobPath(29, 7, 0.22)} transform="translate(80 10) scale(2.8)" fill="color-mix(in srgb, var(--leaf) 50%, var(--bg))" />
            <path d={blobPath(12, 7, 0.2)} transform="translate(330 30) scale(0.42)" fill="var(--sky)" />
            <g class="bubbles">
              <circle cx="62" cy="128" r="20" fill="var(--orange)" />
              <g>
                <rect x="96" y="134" width="24" height="24" rx="5" transform="rotate(45 108 146)" fill="var(--paper)" />
                <rect x="90" y="74" width="190" height="78" rx="26" fill="var(--paper)" />
                <rect x="112" y="96" width="102" height="10" rx="5" fill="var(--ink)" />
                <rect x="112" y="115" width="138" height="7" rx="3.5" fill="#E6DFD5" />
                <rect x="112" y="129" width="88" height="7" rx="3.5" fill="#E6DFD5" />
              </g>
              <g class="reply">
                <rect x="300" y="226" width="24" height="24" rx="5" transform="rotate(45 312 238)" fill="var(--ink)" />
                <rect x="186" y="176" width="140" height="62" rx="24" fill="var(--ink)" />
                <circle class="typing" cx="232" cy="207" r="7" fill="var(--bg)" />
                <circle class="typing" cx="256" cy="207" r="7" fill="var(--bg)" style="animation-delay: 0.15s" />
                <circle class="typing" cx="280" cy="207" r="7" fill="var(--bg)" style="animation-delay: 0.3s" />
              </g>
            </g>
          </svg>
        </div>
      </div>

      <form class="form" data-contact-form novalidate>
        <input type="checkbox" name="botcheck" class="visually-hidden" tabindex="-1" autocomplete="off" aria-hidden="true" />
        <div class="fields" data-fields>
        <div class="row2">
          <label class="field">
            <span>Name</span>
            <input id="c-name" name="name" type="text" autocomplete="name" required maxlength="120" />
          </label>
          <label class="field">
            <span>Email</span>
            <input id="c-email" name="email" type="email" autocomplete="email" required maxlength="160" />
          </label>
        </div>
        <fieldset class="topics">
          <legend>What is it about?</legend>
          <div class="chips">
            {topics.map((t, i) => (
              <label class="chip">
                <input type="radio" name="topic" value={t} checked={i === 0} />
                <span>{t}</span>
              </label>
            ))}
          </div>
        </fieldset>
        <label class="field">
          <span>Message</span>
          <textarea id="c-message" name="message" rows="5" required maxlength="4000" placeholder="The project, the timeline, anything you'd like me to know."></textarea>
        </label>
        <p class="status" data-status role="status" aria-live="polite"></p>
        <button class="btn submit" type="submit" data-submit>
          Send message
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </button>
        </div>

        <!-- Shown in place of the fields once the message is on its way. -->
        <div class="sent" data-sent hidden>
          <span class="sent-badge" aria-hidden="true">
            <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"><path d="M14 25l7 7 14-15" pathLength="1" /></svg>
          </span>
          <h3 class="sent-title" tabindex="-1" data-sent-title>Message sent.</h3>
          <p class="sent-text" data-sent-text></p>
          <div class="sent-recap">
            <span class="sent-topic" data-sent-topic></span>
            <p class="sent-msg" data-sent-msg></p>
          </div>
          <p class="sent-alt" data-sent-alt hidden>
            Nothing opened? Write to <a href={`mailto:${site.email}`}>{site.email}</a>.
          </p>
          <button class="btn btn--ghost sent-again" type="button" data-again>
            Send another message
          </button>
        </div>
      </form>
    </div>
  </div>
</section>

<style>
  .contact { position: relative; margin-top: clamp(32px, 6vw, 72px); }
  .contact-in { background: var(--surface); padding-block: clamp(32px, 6vw, 72px) clamp(64px, 10vw, 120px); }
  .grid { display: grid; gap: clamp(36px, 6vw, 72px); }
  .intro { display: grid; gap: 18px; align-content: start; }
  .intro h2 { font-size: var(--step-h2); max-width: 14ch; }
  .intro > p { color: var(--muted); font-size: var(--step-lead); max-width: 46ch; }
  .direct { margin-top: 12px; display: grid; gap: 6px; }
  .direct > p { color: var(--muted); font-size: var(--step-small); }
  .email-row { display: flex; flex-wrap: wrap; align-items: center; gap: 12px; }
  .email-row a { font-family: var(--font-display); font-weight: 500; font-size: clamp(1.25rem, 1rem + 1vw, 1.625rem); text-decoration-color: var(--orange); overflow-wrap: anywhere; }
  .copy {
    font: 600 0.875rem/1 var(--font-body); padding: 9px 14px; border-radius: 999px; cursor: pointer;
    border: 0; background: var(--bg); color: var(--ink);
  }
  .copy:hover { background: var(--line); }
  .scene { position: relative; height: clamp(220px, 50vw, 300px); margin-top: 8px; }
  .art { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
  .bubbles { filter: drop-shadow(0 14px 18px color-mix(in srgb, var(--ink) 14%, transparent)); }
  .typing { transform-box: fill-box; transform-origin: center; animation: typing 1.2s ease-in-out infinite; }
  @keyframes typing { 0%, 60%, 100% { transform: none; opacity: 0.55; } 30% { transform: translateY(-7px); opacity: 1; } }
  @media (prefers-reduced-motion: reduce) { .typing { animation: none; } }

  .form {
    display: grid; gap: 20px; padding: clamp(24px, 4vw, 40px);
    background: var(--bg); border-radius: 40px 28px 44px 24px / 28px 44px 24px 40px;
  }
  .row2 { display: grid; gap: 20px; }
  .field { display: grid; gap: 8px; }
  .field > span, legend { font-weight: 600; font-size: var(--step-small); }
  input[type="text"], input[type="email"], textarea {
    width: 100%; font: inherit; color: var(--ink); background: var(--bg);
    border: 2px solid var(--line); border-radius: 16px; padding: 14px 16px;
    transition: border-color 160ms ease-out;
  }
  textarea { resize: vertical; min-height: 140px; }
  input::placeholder, textarea::placeholder { color: color-mix(in srgb, var(--muted) 80%, transparent); }
  input:hover, textarea:hover { border-color: color-mix(in srgb, var(--ink) 30%, transparent); }
  input:focus-visible, textarea:focus-visible { outline: none; border-color: var(--blue); }
  [aria-invalid="true"] { border-color: #B3261E !important; }
  .topics { border: 0; padding: 0; margin: 0; display: grid; gap: 10px; }
  .chips { display: flex; flex-wrap: wrap; gap: 8px; }
  .chip { position: relative; cursor: pointer; }
  .chip input { position: absolute; opacity: 0; inset: 0; cursor: pointer; }
  .chip span {
    display: inline-flex; align-items: center; min-height: 44px; padding: 0 18px; border-radius: 999px;
    background: var(--surface); font-weight: 500; transition: background-color 160ms ease-out, color 160ms ease-out;
  }
  .chip:hover span { background: var(--line); }
  .chip input:checked + span { background: var(--ink); color: var(--bg); }
  .chip input:focus-visible + span { outline: 3px solid var(--blue); outline-offset: 3px; }
  .status { font-weight: 500; }
  .status:empty { display: none; }
  .status[data-state="error"] { color: #B3261E; }
  .status[data-state="ok"] { color: #1F6B3A; }
  .fields { display: grid; gap: 20px; }
  .fields[hidden] { display: none; }
  .submit { justify-self: start; }

  /* Success screen. */
  .sent {
    display: grid; justify-items: center; align-content: center; gap: 14px; text-align: center; height: 100%;
    padding: clamp(16px, 4vw, 40px) 0;
  }
  .sent[hidden] { display: none; }
  .sent-badge {
    display: grid; place-items: center; width: 76px; height: 76px; border-radius: 50%;
    background: var(--orange); color: #fff; margin-bottom: 6px;
    box-shadow: 0 0 0 10px color-mix(in srgb, var(--orange) 14%, transparent);
    animation: badge-in 520ms cubic-bezier(0.3, 1.5, 0.5, 1) both;
  }
  .sent-badge svg { width: 40px; height: 40px; }
  .sent-badge path { stroke-dasharray: 1; stroke-dashoffset: 1; animation: tick 420ms 280ms ease-out forwards; }
  .sent-title { font-size: clamp(1.75rem, 1.3rem + 1.6vw, 2.25rem); letter-spacing: -0.03em; outline: none; }
  .sent-text { color: var(--muted); max-width: 36ch; }
  .sent-recap {
    width: 100%; max-width: 420px; margin-top: 6px; padding: 16px 18px; text-align: left;
    background: var(--surface); border-radius: 18px;
  }
  .sent-topic {
    display: inline-block; margin-bottom: 8px; padding: 4px 10px; border-radius: 999px;
    background: var(--ink); color: var(--bg); font-size: 0.8125rem; font-weight: 600;
  }
  .sent-msg {
    color: var(--muted); font-size: var(--step-small); line-height: 1.5;
    display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;
  }
  .sent-alt { font-size: var(--step-small); color: var(--muted); }
  .sent-alt a { color: var(--ink); font-weight: 600; }
  .sent-again { margin-top: 8px; }
  .sent > :not(.sent-badge) { animation: sent-rise 520ms calc(200ms + var(--n, 0) * 70ms) var(--ease-out) both; }
  .sent-title { --n: 1; } .sent-text { --n: 2; } .sent-recap { --n: 3; } .sent-alt { --n: 4; } .sent-again { --n: 5; }
  @keyframes badge-in { from { transform: scale(0.4); opacity: 0; } }
  @keyframes tick { to { stroke-dashoffset: 0; } }
  @keyframes sent-rise { from { opacity: 0; transform: translateY(10px); } }
  .submit[disabled] { opacity: 0.6; cursor: progress; }

  @media (min-width: 640px) { .row2 { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 1000px) { .grid { grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr); } }
</style>

<script>
  const ACCESS_KEY = import.meta.env.PUBLIC_WEB3FORMS_KEY as string | undefined;
  const CONTACT_EMAIL = 'josedvilla18@gmail.com';

  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((b) =>
    b.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(b.dataset.copy ?? '');
        b.textContent = 'Copied';
      } catch {
        b.textContent = 'Press Ctrl+C';
      }
      setTimeout(() => (b.textContent = 'Copy'), 1600);
    }),
  );

  document.querySelectorAll<HTMLFormElement>('[data-contact-form]').forEach((form) => {
    const status = form.querySelector<HTMLElement>('[data-status]')!;
    const submit = form.querySelector<HTMLButtonElement>('[data-submit]')!;
    const say = (state: 'ok' | 'error' | '', text: string) => {
      status.dataset.state = state;
      status.textContent = text;
    };
    const fieldsEl = form.querySelector<HTMLElement>('[data-fields]')!;
    const sent = form.querySelector<HTMLElement>('[data-sent]')!;
    const title = form.querySelector<HTMLElement>('[data-sent-title]')!;
    const text = form.querySelector<HTMLElement>('[data-sent-text]')!;
    const topicEl = form.querySelector<HTMLElement>('[data-sent-topic]')!;
    const msgEl = form.querySelector<HTMLElement>('[data-sent-msg]')!;
    const alt = form.querySelector<HTMLElement>('[data-sent-alt]')!;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const data = new FormData(form);
      if (data.get('botcheck')) return;

      // Validate next to the fields, not only at the top.
      const fields = ['name', 'email', 'message'] as const;
      let firstBad: HTMLInputElement | HTMLTextAreaElement | null = null;
      for (const name of fields) {
        const el = form.elements.namedItem(name) as HTMLInputElement | HTMLTextAreaElement;
        const ok = el.checkValidity() && String(el.value).trim() !== '';
        el.setAttribute('aria-invalid', String(!ok));
        if (!ok && !firstBad) firstBad = el;
      }
      if (firstBad) {
        say('error', 'Please add your name, a valid email and a short message.');
        firstBad.focus();
        return;
      }

      const name = String(data.get('name')).trim();
      const email = String(data.get('email')).trim();
      const topic = String(data.get('topic') ?? '');
      const message = String(data.get('message')).trim();
      const subject = `[${topic}] Portfolio message from ${name}`;

      // Without a form key, or if the service fails, hand the message to the
      // visitor's email app, already written, so it still reaches the inbox.
      const viaEmailApp = () => {
        const body = `${message}\n\n${name}\n${email}`;
        window.location.href = `mailto:${CONTACT_EMAIL}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
        showSent(name, email, topic, message, 'mailto');
      };

      if (!ACCESS_KEY) return viaEmailApp();

      submit.disabled = true;
      say('', 'Sending…');
      try {
        const res = await fetch('https://api.web3forms.com/submit', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify({
            access_key: ACCESS_KEY,
            subject,
            from_name: 'Portfolio contact form',
            name, email, replyto: email, topic, message,
          }),
        });
        const json = await res.json().catch(() => ({}));
        if (!res.ok || !json.success) throw new Error(json.message || 'Request failed');
        showSent(name, email, topic, message, 'sent');
      } catch {
        viaEmailApp();
      } finally {
        submit.disabled = false;
      }
    });

    const showSent = (name: string, email: string, topic: string, message: string, how: 'sent' | 'mailto') => {
      say('', '');
      title.textContent = how === 'sent' ? `Thanks, ${name.split(' ')[0]}.` : `Almost there, ${name.split(' ')[0]}.`;
      text.textContent = how === 'sent'
        ? `Your message is in my inbox. I'll reply to ${email} within a day or two.`
        : 'Your email app just opened with the message written for you. Hit send there and it lands straight in my inbox.';
      topicEl.textContent = topic;
      msgEl.textContent = message;
      alt.hidden = how === 'sent';
      fieldsEl.hidden = true;
      sent.hidden = false;
      title.focus({ preventScroll: true });
      form.scrollIntoView({ behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth', block: 'center' });
      window.dispatchEvent(new CustomEvent('contact:sent'));
    };

    form.querySelector('[data-again]')!.addEventListener('click', () => {
      form.reset();
      (['name', 'email', 'message'] as const).forEach((n) => (form.elements.namedItem(n) as HTMLElement).removeAttribute('aria-invalid'));
      sent.hidden = true;
      fieldsEl.hidden = false;
      (form.elements.namedItem('name') as HTMLInputElement).focus();
    });
  });
</script>
