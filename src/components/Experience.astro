---
import { blobPath } from '../lib/shapes';
import { getCollection, render } from 'astro:content';

const all = (await getCollection('experience')).sort((a, b) => a.data.order - b.data.order);
const withContent = await Promise.all(all.map(async (e) => ({ ...e, Content: (await render(e)).Content })));
const current = withContent.filter((e) => e.data.group === 'current');
const earlier = withContent.filter((e) => e.data.group === 'earlier');
---
<section id="experience" class="section experience" aria-labelledby="exp-title">
  <div class="container">
    <div class="exp-head">
      <div class="section-head">
        <h2 id="exp-title">Experience</h2>
        <p>3+ years building web and mobile apps, and 4+ years of bilingual client work.</p>
      </div>
      <div class="scene" aria-hidden="true">
        <svg class="art" viewBox="0 0 400 300" focusable="false">
          <path class="backdrop" d={blobPath(17, 7, 0.22)} transform="translate(92 6) scale(2.9)" fill="color-mix(in srgb, var(--sky) 45%, var(--bg))" />
          <path class="sat" d={blobPath(3, 7, 0.22)} transform="translate(318 214) scale(0.5)" fill="var(--sun)" />
          <g class="deck">
            <g class="card card-1" transform="translate(236 118) rotate(9)">
              <g class="card-in">
                <rect x="-88" y="-58" width="176" height="116" rx="16" fill="var(--paper)" />
                <rect x="-80" y="-50" width="160" height="32" rx="10" fill="var(--sky)" />
                <circle cx="-61" cy="-34" r="9" fill="var(--paper)" />
                <rect x="-70" y="-4" width="78" height="9" rx="4.5" fill="var(--ink)" />
                <rect x="-70" y="12" width="112" height="7" rx="3.5" fill="#E6DFD5" />
                <rect x="-70" y="25" width="84" height="7" rx="3.5" fill="#E6DFD5" />
                <rect x="-70" y="40" width="34" height="11" rx="5.5" fill="var(--surface)" />
                <rect x="-31" y="40" width="28" height="11" rx="5.5" fill="var(--surface)" />
              </g>
            </g>
            <g class="card card-2" transform="translate(208 136) rotate(-2)">
              <g class="card-in">
                <rect x="-88" y="-58" width="176" height="116" rx="16" fill="var(--paper)" />
                <rect x="-80" y="-50" width="160" height="32" rx="10" fill="var(--leaf)" />
                <circle cx="-61" cy="-34" r="9" fill="var(--paper)" />
                <rect x="-70" y="-4" width="78" height="9" rx="4.5" fill="var(--ink)" />
                <rect x="-70" y="12" width="112" height="7" rx="3.5" fill="#E6DFD5" />
                <rect x="-70" y="25" width="84" height="7" rx="3.5" fill="#E6DFD5" />
                <rect x="-70" y="40" width="34" height="11" rx="5.5" fill="var(--surface)" />
                <rect x="-31" y="40" width="28" height="11" rx="5.5" fill="var(--surface)" />
              </g>
            </g>
            <g class="card card-3" transform="translate(176 156) rotate(-10)">
              <g class="card-in">
                <rect x="-88" y="-58" width="176" height="116" rx="16" fill="var(--paper)" />
                <rect x="-80" y="-50" width="160" height="32" rx="10" fill="var(--orange)" />
                <circle cx="-61" cy="-34" r="9" fill="var(--paper)" />
                <rect x="-70" y="-4" width="78" height="9" rx="4.5" fill="var(--ink)" />
                <rect x="-70" y="12" width="112" height="7" rx="3.5" fill="#E6DFD5" />
                <rect x="-70" y="25" width="84" height="7" rx="3.5" fill="#E6DFD5" />
                <rect x="-70" y="40" width="34" height="11" rx="5.5" fill="var(--surface)" />
                <rect x="-31" y="40" width="28" height="11" rx="5.5" fill="var(--surface)" />
              </g>
            </g>
          </g>
        </svg>
      </div>
    </div>

    <ol class="roles">
      {current.map(({ data, Content }) => (
        <li class="role">
          <p class="period">{data.period}</p>
          <div class="role-body">
            <h3>{data.role}</h3>
            <p class="company">
              {data.url ? <a href={data.url} target="_blank" rel="noopener">{data.company}</a> : data.company}
            </p>
            <div class="desc"><Content /></div>
            {data.stack && (
              <ul class="tags" aria-label={`${data.company} stack`}>
                {data.stack.map((t) => <li>{t}</li>)}
              </ul>
            )}
          </div>
        </li>
      ))}
    </ol>

    <div class="extra">
      <div class="panel earlier">
        <h3>Bilingual client-facing roles</h3>
        <ul>
          {earlier.map(({ data, Content }) => (
            <li>
              <p class="e-role">{data.role}</p>
              <p class="e-meta">{data.company} · {data.period}</p>
              <div class="e-desc"><Content /></div>
            </li>
          ))}
        </ul>
      </div>

      <div class="panel lang" aria-labelledby="lang-title">
        <h3 id="lang-title">Languages</h3>
        <ul class="langs">
          <li class="lang-card">
            <svg class="flag" viewBox="0 0 60 40" role="img" aria-label="Flag of Colombia">
              <clipPath id="flag-co"><rect width="60" height="40" rx="7" /></clipPath>
              <g clip-path="url(#flag-co)">
                <rect width="60" height="20" fill="#FCD116" />
                <rect y="20" width="60" height="10" fill="#003893" />
                <rect y="30" width="60" height="10" fill="#CE1126" />
              </g>
              <rect x="1.25" y="1.25" width="57.5" height="37.5" rx="6" fill="none" stroke="var(--ink)" stroke-width="2.5" />
            </svg>
            <div class="lang-text">
              <p class="lang-name">Spanish</p>
              <p class="lang-note">First language</p>
            </div>
            <div class="level">
              <p class="lvl">Native</p>
              <span class="meter" aria-hidden="true">{[1, 2, 3, 4, 5].map(() => <i class="on"></i>)}</span>
            </div>
          </li>
          <li class="lang-card">
            <svg class="flag" viewBox="0 0 60 40" role="img" aria-label="Flag of the United States">
              <clipPath id="flag-us"><rect width="60" height="40" rx="7" /></clipPath>
              <g clip-path="url(#flag-us)">
                <rect width="60" height="40" fill="#FFFFFF" />
                {Array.from({ length: 7 }, (_, i) => <rect y={i * 6.16} width="60" height="3.08" fill="#B22234" />)}
                <rect width="26" height="21.5" fill="#3C3B6E" />
                {Array.from({ length: 4 }, (_, r) => Array.from({ length: 5 }, (_, c) => (
                  <circle cx={3.4 + c * 4.8 + (r % 2) * 2.4} cy={3.2 + r * 5} r="1.05" fill="#FFFFFF" />
                )))}
              </g>
              <rect x="1.25" y="1.25" width="57.5" height="37.5" rx="6" fill="none" stroke="var(--ink)" stroke-width="2.5" />
            </svg>
            <div class="lang-text">
              <p class="lang-name">English</p>
              <p class="lang-note">Daily work with US clients and teams</p>
            </div>
            <div class="level">
              <p class="lvl">Advanced</p>
              <span class="meter" aria-hidden="true">{[1, 2, 3, 4, 5].map((n) => <i class={n <= 4 ? 'on' : ''}></i>)}</span>
            </div>
          </li>
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .exp-head { display: grid; gap: 8px; align-items: center; }
  .exp-head .section-head { margin-bottom: 0; }
  .scene { position: relative; height: clamp(220px, 58vw, 380px); }
  .art { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
  .deck { filter: drop-shadow(0 14px 18px color-mix(in srgb, var(--ink) 16%, transparent)); }
  /* The fan slowly opens and closes; the front card lifts a little. */
  .card-in { transform-box: fill-box; transform-origin: 50% 100%; animation: fan 7s ease-in-out infinite; }
  .card-1 .card-in { --r: 4deg; }
  .card-2 .card-in { --r: 1deg; animation-delay: -0.4s; }
  .card-3 .card-in { --r: -4deg; --y: -8px; animation-delay: -0.8s; }
  @keyframes fan { 50% { transform: rotate(var(--r, 0deg)) translateY(var(--y, 0px)); } }
  .backdrop, .sat { transform-box: fill-box; }
  @media (prefers-reduced-motion: reduce) { .card-in { animation: none; } }
  .exp-head { margin-bottom: clamp(24px, 4vw, 48px); }
  .roles { list-style: none; margin: 0; padding: 0; display: grid; }
  .role { display: grid; gap: 8px 40px; padding: clamp(24px, 3vw, 36px) 0; border-top: 1px solid var(--line); }
  .role:last-child { border-bottom: 1px solid var(--line); }
  .period { color: var(--muted); font-weight: 500; font-variant-numeric: tabular-nums; }
  .role h3 { font-size: var(--step-h3); line-height: 1.15; }
  .company { font-weight: 600; margin-top: 4px; }
  .company a { text-decoration-color: var(--orange); }
  .company a:hover { text-decoration-color: var(--ink); }
  .desc { margin-top: 14px; max-width: 66ch; }
  .desc :global(ul) { margin: 0; padding: 0; list-style: none; display: grid; gap: 8px; }
  .desc :global(li) { position: relative; padding-left: 22px; }
  .desc :global(li)::before {
    content: ""; position: absolute; left: 0; top: 0.6em; width: 10px; height: 10px;
    background: var(--orange); border-radius: 52% 48% 40% 60% / 60% 42% 58% 40%;
  }
  .role .tags { margin-top: 16px; }

  .extra { display: grid; gap: 20px; margin-top: clamp(40px, 6vw, 64px); }
  .panel { padding: clamp(24px, 4vw, 40px); background: var(--surface); }
  .panel h3 { font-size: var(--step-h3); margin-bottom: 18px; }
  .earlier { border-radius: 56px 32px 64px 28px / 36px 60px 30px 56px; }
  .earlier ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 22px; }
  .e-role { font-weight: 600; }
  .e-meta { color: var(--muted); font-size: var(--step-small); }
  .e-desc { color: var(--muted); font-size: var(--step-small); max-width: 70ch; margin-top: 4px; }
  .e-desc :global(p) { margin: 0; }
  .lang { background: var(--leaf); border-radius: 48px 28px 52px 32px / 30px 52px 28px 48px; align-self: start; }
  .langs { list-style: none; margin: 0; padding: 0; display: grid; gap: 14px; }
  .lang-card {
    display: grid; grid-template-columns: auto minmax(0, 1fr); align-items: center; gap: 14px 18px;
    padding: 18px 20px; background: var(--bg);
    border-radius: 28px 18px 30px 16px / 18px 30px 16px 28px;
  }
  .flag { width: 64px; height: auto; flex: none; transform: rotate(-4deg); transition: transform 300ms var(--ease-out); }
  .lang-card:nth-child(2) .flag { transform: rotate(3deg); }
  .lang-card:hover .flag { transform: rotate(0deg) scale(1.06); }
  .lang-name { font-family: var(--font-display); font-weight: 500; font-size: 1.5rem; line-height: 1.1; letter-spacing: -0.02em; }
  .lang-note { color: var(--muted); font-size: var(--step-small); }
  .level { grid-column: 1 / -1; display: flex; align-items: center; justify-content: space-between; gap: 12px;
    padding-top: 12px; border-top: 1px solid var(--line); }
  .lvl { font-weight: 600; }
  .meter { display: inline-flex; gap: 6px; }
  .meter i {
    width: 16px; height: 16px; border: 2px solid var(--ink);
    border-radius: 52% 48% 40% 60% / 60% 42% 58% 40%;
  }
  .meter i.on { background: var(--blue); }

  @media (min-width: 860px) {
    .role { grid-template-columns: 220px minmax(0, 1fr); }
    .period { padding-top: 6px; }
  }
  @media (min-width: 1000px) {
    .extra { grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr); }
  }
  @media (min-width: 860px) {
    .exp-head { grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr); }
  }
</style>
