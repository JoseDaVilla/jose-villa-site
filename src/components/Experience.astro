---
import { getCollection, render } from 'astro:content';

const all = (await getCollection('experience')).sort((a, b) => a.data.order - b.data.order);
const withContent = await Promise.all(all.map(async (e) => ({ ...e, Content: (await render(e)).Content })));
const current = withContent.filter((e) => e.data.group === 'current');
const earlier = withContent.filter((e) => e.data.group === 'earlier');
---
<section id="experience" class="section experience" aria-labelledby="exp-title">
  <div class="container">
    <div class="exp-head">
      <div class="section-head">
        <h2 id="exp-title">Experience</h2>
        <p>3+ years building web and mobile apps, and 4+ years of bilingual client work.</p>
      </div>
      <div class="scene" data-briefcase-scene aria-hidden="true">
        <svg class="poster" viewBox="0 0 400 300" focusable="false">
          <g stroke="var(--ink)" stroke-width="5" stroke-linejoin="round">
            <rect x="150" y="40" width="120" height="70" rx="10" fill="var(--paper, #FFFDF8)" transform="rotate(-8 210 75)" />
            <rect x="185" y="30" width="120" height="70" rx="10" fill="var(--sky)" transform="rotate(7 245 65)" />
            <path d="M172 92 a28 28 0 0 1 56 0" fill="none" stroke-width="12" stroke="var(--ink)" />
            <path d="M172 92 a28 28 0 0 1 56 0" fill="none" stroke-width="6" stroke="var(--blue)" />
            <rect x="90" y="92" width="220" height="150" rx="18" fill="var(--orange)" />
            <rect x="88" y="172" width="224" height="18" rx="6" fill="var(--blue)" />
            <rect x="130" y="112" width="26" height="20" rx="4" fill="var(--sun)" />
            <rect x="244" y="112" width="26" height="20" rx="4" fill="var(--sun)" />
          </g>
          <circle cx="58" cy="70" r="22" fill="var(--sky)" stroke="var(--ink)" stroke-width="5" />
        </svg>
        <canvas></canvas>
      </div>
    </div>

    <ol class="roles">
      {current.map(({ data, Content }) => (
        <li class="role">
          <p class="period">{data.period}</p>
          <div class="role-body">
            <h3>{data.role}</h3>
            <p class="company">
              {data.url ? <a href={data.url} target="_blank" rel="noopener">{data.company}</a> : data.company}
            </p>
            <div class="desc"><Content /></div>
            {data.stack && (
              <ul class="tags" aria-label={`${data.company} stack`}>
                {data.stack.map((t) => <li>{t}</li>)}
              </ul>
            )}
          </div>
        </li>
      ))}
    </ol>

    <div class="extra">
      <div class="panel earlier">
        <h3>Bilingual client-facing roles</h3>
        <ul>
          {earlier.map(({ data, Content }) => (
            <li>
              <p class="e-role">{data.role}</p>
              <p class="e-meta">{data.company} · {data.period}</p>
              <div class="e-desc"><Content /></div>
            </li>
          ))}
        </ul>
      </div>

      <div class="side">
        <div class="panel edu">
          <h3>Education</h3>
          <p class="e-role">Coderhouse</p>
          <p class="e-meta">Aug 2023 — Sep 2024</p>
          <ul class="plain">
            <li>Full Stack Development Career</li>
            <li>React Frontend Development Career</li>
            <li>JavaScript</li>
            <li>Web Development</li>
          </ul>
        </div>
        <div class="panel lang">
          <h3>Languages</h3>
          <dl>
            <div><dt>Spanish</dt><dd>Native</dd></div>
            <div><dt>English</dt><dd>Advanced</dd></div>
          </dl>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .exp-head { display: grid; gap: 8px; align-items: center; }
  .exp-head .section-head { margin-bottom: 0; }
  .scene { position: relative; height: clamp(220px, 50vw, 300px); }
  .scene .poster, .scene canvas { position: absolute; inset: 0; width: 100%; height: 100%; }
  .scene .poster { padding: 4%; transition: opacity 400ms ease-out; }
  .scene canvas { opacity: 0; transition: opacity 500ms ease-out; }
  .scene[data-ready] canvas { opacity: 1; }
  .scene[data-ready] .poster { opacity: 0; }
  .exp-head { margin-bottom: clamp(24px, 4vw, 48px); }
  .roles { list-style: none; margin: 0; padding: 0; display: grid; }
  .role { display: grid; gap: 8px 40px; padding: clamp(24px, 3vw, 36px) 0; border-top: 1px solid var(--line); }
  .role:last-child { border-bottom: 1px solid var(--line); }
  .period { color: var(--muted); font-weight: 500; font-variant-numeric: tabular-nums; }
  .role h3 { font-size: var(--step-h3); line-height: 1.15; }
  .company { font-weight: 600; margin-top: 4px; }
  .company a { text-decoration-color: var(--orange); }
  .company a:hover { text-decoration-color: var(--ink); }
  .desc { margin-top: 14px; max-width: 66ch; }
  .desc :global(ul) { margin: 0; padding: 0; list-style: none; display: grid; gap: 8px; }
  .desc :global(li) { position: relative; padding-left: 22px; }
  .desc :global(li)::before {
    content: ""; position: absolute; left: 0; top: 0.6em; width: 10px; height: 10px;
    background: var(--orange); border-radius: 52% 48% 40% 60% / 60% 42% 58% 40%;
  }
  .role .tags { margin-top: 16px; }

  .extra { display: grid; gap: 20px; margin-top: clamp(40px, 6vw, 64px); }
  .panel { padding: clamp(24px, 4vw, 40px); background: var(--surface); }
  .panel h3 { font-size: var(--step-h3); margin-bottom: 18px; }
  .earlier { border-radius: 56px 32px 64px 28px / 36px 60px 30px 56px; }
  .earlier ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 22px; }
  .e-role { font-weight: 600; }
  .e-meta { color: var(--muted); font-size: var(--step-small); }
  .e-desc { color: var(--muted); font-size: var(--step-small); max-width: 70ch; margin-top: 4px; }
  .e-desc :global(p) { margin: 0; }
  .side { display: grid; gap: 20px; align-content: start; }
  .edu { background: var(--sun); border-radius: 32px 60px 28px 56px / 56px 30px 60px 36px; }
  .edu .e-meta { color: var(--ink); }
  .plain { list-style: none; margin: 12px 0 0; padding: 0; display: grid; gap: 4px; }
  .lang { background: var(--leaf); border-radius: 48px 28px 52px 32px / 30px 52px 28px 48px; }
  dl { margin: 0; display: grid; gap: 8px; }
  dl div { display: flex; justify-content: space-between; gap: 16px; }
  dt { font-weight: 600; }
  dd { margin: 0; }

  @media (min-width: 860px) {
    .role { grid-template-columns: 220px minmax(0, 1fr); }
    .period { padding-top: 6px; }
  }
  @media (min-width: 1000px) {
    .extra { grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr); }
  }
  @media (min-width: 860px) {
    .exp-head { grid-template-columns: minmax(0, 1fr) minmax(0, 0.9fr); }
  }
</style>

<script>
  import { lazyScene } from '../scripts/lazy-scene';
  lazyScene('[data-briefcase-scene]', async () => (await import('../scripts/briefcase-scene')).mountBriefcaseScene);
</script>
