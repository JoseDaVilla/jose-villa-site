---
import { blobPath } from '../lib/shapes';
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import JVMark from './JVMark.astro';
import latam from '../assets/logos/latam.png';
import spirit from '../assets/logos/spirit.png';
import travelperk from '../assets/logos/travelperk.png';
import kaseya from '../assets/logos/kaseya.png';
import geeks5g from '../assets/logos/geeks5g-mark.png';
import flagCo from '../assets/logos/co.svg';
import flagUs from '../assets/logos/us.svg';

const all = (await getCollection('experience')).sort((a, b) => a.data.order - b.data.order);
const withContent = await Promise.all(all.map(async (e) => ({ ...e, Content: (await render(e)).Content })));
const current = withContent.filter((e) => e.data.group === 'current');
const earlier = withContent.filter((e) => e.data.group === 'earlier');

// Brand marks. Employers without a public logo we can ship get a neutral monogram.
const mono: Record<string, string> = {};
const employerLogo: Record<string, ImageMetadata> = { kaseya, geeks5g };
const projectsById = new Map((await getCollection('projects')).map((p) => [p.id, p]));
// The airline or company each bilingual role served.
const client: Record<string, { name: string; logo: ImageMetadata }> = {
  solvo: { name: 'Spirit Airlines', logo: spirit },
  igt: { name: 'TravelPerk', logo: travelperk },
  almacontact: { name: 'LATAM Airlines', logo: latam },
};
---
<section id="experience" class="section experience" aria-labelledby="exp-title">
  <div class="container">
    <div class="exp-head">
      <div class="section-head">
        <h2 id="exp-title">Experience</h2>
        <p>3+ years building web and mobile apps, and 4+ years of bilingual client work.</p>
      </div>
      <div class="scene" aria-hidden="true">
        <svg class="art" viewBox="0 0 400 300" focusable="false">
          <path d={blobPath(17, 7, 0.22)} transform="translate(92 6) scale(2.9)" fill="var(--surface)" />
          <path d={blobPath(3, 7, 0.22)} transform="translate(318 214) scale(0.5)" fill="var(--orange)" />
        </svg>
        <!-- A deck of work cards (what I build); the front card flies off and rejoins at the back. -->
        <div class="deck" style="--n: 6">
          <div class="dcard" style="--k: 0">
            <svg class="dart" viewBox="0 0 130 80" aria-hidden="true"><rect x="0" y="0" width="34" height="80" rx="6" fill="var(--surface)"/><rect x="8" y="12" width="18" height="4" rx="2" fill="var(--line)"/><rect x="8" y="22" width="14" height="4" rx="2" fill="var(--line)"/><rect x="8" y="32" width="18" height="4" rx="2" fill="var(--line)"/>
<rect x="44" y="0" width="40" height="22" rx="6" fill="var(--surface)"/><rect x="90" y="0" width="40" height="22" rx="6" fill="var(--surface)"/><rect x="50" y="7" width="18" height="8" rx="2" fill="var(--ink)"/><rect x="96" y="7" width="22" height="8" rx="2" fill="var(--orange)"/>
<rect x="48" y="60" width="10" height="20" rx="3" fill="var(--ink)"/><rect x="64" y="48" width="10" height="32" rx="3" fill="var(--ink)"/><rect x="80" y="54" width="10" height="26" rx="3" fill="var(--ink)"/><rect x="96" y="34" width="10" height="46" rx="3" fill="var(--orange)"/><rect x="112" y="42" width="10" height="38" rx="3" fill="var(--ink)"/></svg>
            <span class="drole">Dashboards</span>
            <span class="dmeta">SaaS & B2B platforms</span>
          </div>
          <div class="dcard" style="--k: 1">
            <svg class="dart" viewBox="0 0 130 80" aria-hidden="true"><rect x="40" y="0" width="50" height="80" rx="10" fill="var(--ink)"/><rect x="44" y="6" width="42" height="68" rx="6" fill="var(--paper)"/><rect x="50" y="12" width="30" height="16" rx="4" fill="var(--orange)"/><rect x="50" y="34" width="24" height="4" rx="2" fill="var(--ink)"/><rect x="50" y="42" width="30" height="4" rx="2" fill="var(--line)"/><rect x="50" y="56" width="30" height="10" rx="5" fill="var(--ink)"/>
<rect x="100" y="14" width="30" height="52" rx="7" fill="var(--surface)"/><rect x="0" y="22" width="30" height="52" rx="7" fill="var(--surface)"/></svg>
            <span class="drole">Mobile apps</span>
            <span class="dmeta">React Native</span>
          </div>
          <div class="dcard" style="--k: 2">
            <svg class="dart" viewBox="0 0 130 80" aria-hidden="true"><path d="M28 20 C 55 20, 55 40, 65 40 M28 60 C 55 60, 55 40, 65 40 M95 40 H 108" fill="none" stroke="var(--line)" stroke-width="3"/>
<rect x="0" y="8" width="28" height="24" rx="7" fill="var(--surface)"/><rect x="0" y="48" width="28" height="24" rx="7" fill="var(--surface)"/><rect x="65" y="26" width="30" height="28" rx="8" fill="var(--orange)"/><circle cx="119" cy="40" r="12" fill="var(--ink)"/><path d="M114 40 l4 4 l7 -8" fill="none" stroke="var(--paper)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
<path d="M76 34 l8 6 l-8 6z" fill="var(--paper)"/></svg>
            <span class="drole">Automation</span>
            <span class="dmeta">n8n · Python pipelines</span>
          </div>
          <div class="dcard" style="--k: 3">
            <svg class="dart" viewBox="0 0 130 80" aria-hidden="true"><rect x="0" y="0" width="76" height="80" rx="8" fill="var(--surface)"/><rect x="8" y="8" width="16" height="16" rx="4" fill="var(--paper)"/><rect x="30" y="8" width="16" height="16" rx="4" fill="var(--paper)"/><rect x="52" y="8" width="16" height="16" rx="4" fill="var(--paper)"/><rect x="8" y="30" width="16" height="16" rx="4" fill="var(--paper)"/><rect x="30" y="30" width="16" height="16" rx="4" fill="var(--orange)"/><rect x="52" y="30" width="16" height="16" rx="4" fill="var(--paper)"/><rect x="8" y="52" width="16" height="16" rx="4" fill="var(--paper)"/><rect x="30" y="52" width="16" height="16" rx="4" fill="var(--paper)"/><rect x="52" y="52" width="16" height="16" rx="4" fill="var(--paper)"/>
<rect x="86" y="0" width="44" height="80" rx="8" fill="var(--paper)" stroke="var(--line)" stroke-width="2"/><rect x="94" y="10" width="28" height="4" rx="2" fill="var(--line)"/><rect x="94" y="20" width="20" height="4" rx="2" fill="var(--line)"/><rect x="94" y="30" width="28" height="4" rx="2" fill="var(--line)"/><rect x="94" y="62" width="28" height="9" rx="3" fill="var(--ink)"/></svg>
            <span class="drole">POS systems</span>
            <span class="dmeta">30+ US locations</span>
          </div>
          <div class="dcard" style="--k: 4">
            <svg class="dart" viewBox="0 0 130 80" aria-hidden="true"><rect x="0" y="0" width="130" height="16" rx="5" fill="var(--surface)"/><circle cx="10" cy="8" r="4" fill="var(--line)"/><rect x="20" y="6" width="58" height="4" rx="2" fill="var(--ink)"/><rect x="104" y="4" width="20" height="8" rx="4" fill="var(--orange)"/><rect x="0" y="21" width="130" height="16" rx="5" fill="var(--surface)"/><circle cx="10" cy="29" r="4" fill="var(--line)"/><rect x="20" y="27" width="44" height="4" rx="2" fill="var(--line)"/><rect x="104" y="25" width="20" height="8" rx="4" fill="var(--orange)"/><rect x="0" y="42" width="130" height="16" rx="5" fill="var(--surface)"/><circle cx="10" cy="50" r="4" fill="var(--line)"/><rect x="20" y="48" width="66" height="4" rx="2" fill="var(--line)"/><rect x="104" y="46" width="20" height="8" rx="4" fill="var(--ink)"/><rect x="0" y="63" width="130" height="16" rx="5" fill="var(--surface)"/><circle cx="10" cy="71" r="4" fill="var(--line)"/><rect x="20" y="69" width="50" height="4" rx="2" fill="var(--line)"/><rect x="104" y="67" width="20" height="8" rx="4" fill="var(--orange)"/></svg>
            <span class="drole">Lead validation</span>
            <span class="dmeta">1000s checked daily</span>
          </div>
          <div class="dcard" style="--k: 5">
            <svg class="dart" viewBox="0 0 130 80" aria-hidden="true"><rect x="0" y="0" width="130" height="80" rx="8" fill="var(--surface)"/><rect x="0" y="0" width="130" height="12" rx="6" fill="var(--line)"/><circle cx="8" cy="6" r="2.5" fill="var(--paper)"/><circle cx="16" cy="6" r="2.5" fill="var(--paper)"/>
<rect x="10" y="22" width="56" height="8" rx="3" fill="var(--ink)"/><rect x="10" y="36" width="44" height="4" rx="2" fill="var(--line)"/><rect x="10" y="46" width="30" height="10" rx="5" fill="var(--orange)"/><rect x="76" y="22" width="44" height="46" rx="6" fill="var(--paper)"/><circle cx="98" cy="45" r="11" fill="var(--orange)" opacity=".25"/></svg>
            <span class="drole">Client websites</span>
            <span class="dmeta">Fast, SEO-first sites</span>
          </div>
        </div>
      </div>
    </div>

    <ol class="roles">
      {current.map(({ id, data, Content }) => (
        <li class="role">
          <p class="period">{data.period}</p>
          <div class="role-body">
            <div class="role-head">
              {employerLogo[id]
                ? <span class="brand"><Image src={employerLogo[id]} alt={data.company} height={60} densities={[1, 2]} /></span>
                : id === 'freelance'
                  ? <span class="brand" aria-hidden="true"><JVMark id="jv-freelance" class="brand-jv" /></span>
                  : <span class="mono" aria-hidden="true">{mono[id] ?? data.company[0]}</span>}
              <div>
                <h3>{data.role}</h3>
                <p class="company">
                  {data.url ? <a href={data.url} target="_blank" rel="noopener">{data.company}</a> : data.company}
                </p>
              </div>
            </div>
            <div class="desc"><Content /></div>
            {data.stack && (
              <ul class="tags" aria-label={`${data.company} stack`}>
                {data.stack.map((t) => <li>{t}</li>)}
              </ul>
            )}
            {data.projects && (
              <div class="built">
                <p class="built-title">Projects from this role</p>
                <ul class="built-list">
                  {data.projects.map((pid) => projectsById.get(pid)).filter((p) => !!p).map((p) => (
                    <li>
                      <a href={`#project-${p!.id}`} data-open={p!.id}>
                        <span class="built-thumb" aria-hidden="true">
                          {p!.data.cover && <Image src={p!.data.cover} alt="" widths={[240, 480]} sizes="(min-width: 640px) 220px, 45vw" format="webp" quality={70} loading="lazy" />}
                        </span>
                        <span class="built-name">{p!.data.title}</span>
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            )}
          </div>
        </li>
      ))}
    </ol>

    <div class="extra">
      <h3 class="extra-title">Bilingual client-facing roles</h3>
      <p class="extra-sub">Four years on the front line for airlines and a travel platform, in English and Spanish.</p>
      <ul class="clients">
        {earlier.map(({ id, data, Content }) => (
          <li class="client">
            <div class="client-logo">
              {client[id] && <Image src={client[id].logo} alt={client[id].name} height={52} densities={[1, 2]} />}
            </div>
            <div class="client-text">
              <p class="e-role">{data.role}</p>
              <p class="e-meta">{client[id]?.name} account · via {data.company}</p>
              <p class="e-period">{data.period}</p>
              <div class="e-desc"><Content /></div>
            </div>
          </li>
        ))}
      </ul>

      <div class="langs" aria-labelledby="lang-title">
        <h3 id="lang-title" class="langs-title">Languages</h3>
        <ul>
          <li>
            <img src={flagCo.src} alt="" width="28" height="28" loading="lazy" />
            <span><b>Spanish</b><small>Native</small></span>
          </li>
          <li>
            <img src={flagUs.src} alt="" width="28" height="28" loading="lazy" />
            <span><b>English</b><small>Advanced</small></span>
          </li>
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .exp-head { display: grid; gap: 8px; align-items: center; }
  .exp-head .section-head { margin-bottom: 0; }
  .scene { position: relative; height: clamp(280px, 78vw, 400px); }
  .art { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }

  /* Rotating deck. Each card runs the same loop, offset by --k slots: hold at the
     front, fly off, wait hidden at the back, then step forward through slots 2 and 1. */
  .deck { position: absolute; left: 50%; top: 50%; width: min(64%, 270px); aspect-ratio: 1.12; translate: -54% -50%; }
  .dcard {
    position: absolute; inset: 0; display: grid; align-content: start; gap: 4px;
    padding: 16px 16px 18px; border-radius: 20px; background: var(--paper);
    box-shadow: var(--shadow-card-hover);
    animation: deal calc(var(--n) * 2.4s) calc((var(--n) - var(--k)) * -2.4s) cubic-bezier(0.6, 0, 0.2, 1) infinite;
    opacity: 0;
  }
  .dart { width: 100%; height: auto; margin-bottom: 10px; overflow: visible; }
  .drole { font-weight: 600; font-size: 0.9375rem; line-height: 1.25; }
  .dmeta { color: var(--muted); font-size: 0.8125rem; }

  @keyframes deal {
    0%, 12.5% { transform: translate(0, 0) rotate(-5deg); opacity: 1; z-index: 3; }
    16.6% { transform: translate(-70%, 22%) rotate(-18deg); opacity: 0; z-index: 3; }
    16.7%, 62.5% { transform: translate(16%, -22%) rotate(9deg) scale(0.9); opacity: 0; z-index: 1; }
    66.6%, 79.1% { transform: translate(16%, -22%) rotate(9deg) scale(0.9); opacity: 1; z-index: 1; }
    83.3%, 95.8% { transform: translate(8%, -11%) rotate(2deg) scale(0.95); opacity: 1; z-index: 2; }
    100% { transform: translate(0, 0) rotate(-5deg); opacity: 1; z-index: 3; }
  }
  @media (prefers-reduced-motion: reduce) {
    .dcard { animation: none; opacity: 0; }
    .dcard:first-child { opacity: 1; transform: rotate(-5deg); }
  }
  .exp-head { margin-bottom: clamp(24px, 4vw, 48px); }
  .roles { list-style: none; margin: 0; padding: 0; display: grid; }
  .role { display: grid; gap: 8px 40px; padding: clamp(24px, 3vw, 36px) 0; border-top: 1px solid var(--line); }
  .role:last-child { border-bottom: 1px solid var(--line); }
  .period { color: var(--muted); font-weight: 500; font-variant-numeric: tabular-nums; }
  .role h3 { font-size: var(--step-h3); line-height: 1.15; }
  .company { font-weight: 600; margin-top: 4px; }
  .company a { text-decoration-color: var(--orange); }
  .company a:hover { text-decoration-color: var(--ink); }
  .desc { margin-top: 14px; max-width: 66ch; }
  .desc :global(ul) { margin: 0; padding: 0; list-style: none; display: grid; gap: 8px; }
  .desc :global(li) { position: relative; padding-left: 22px; }
  .desc :global(li)::before {
    content: ""; position: absolute; left: 0; top: 0.6em; width: 10px; height: 10px;
    background: var(--orange); border-radius: 52% 48% 40% 60% / 60% 42% 58% 40%;
  }
  .role .tags { margin-top: 16px; }

  /* Projects shipped in a role: small screenshot chips that open the project dialog. */
  .built { margin-top: 22px; }
  .built-title { font-size: 0.75rem; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; color: var(--muted); margin-bottom: 10px; }
  .built-list { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
  .built-list a {
    display: grid; gap: 8px; padding: 6px 6px 10px; height: 100%;
    border-radius: 14px; background: var(--paper); text-decoration: none; box-shadow: var(--shadow-card);
    transition: box-shadow 200ms ease-out, transform 200ms var(--ease-out);
  }
  /* The whole screenshot, letterboxed on stone: no cropping. */
  .built-thumb {
    display: grid; place-items: center; aspect-ratio: 16 / 9; padding: 10px;
    border-radius: 10px; overflow: hidden; background: var(--surface);
  }
  .built-thumb :global(img) {
    width: 100%; height: auto; max-height: 100%; object-fit: contain;
    border-radius: 4px; box-shadow: 0 4px 12px -6px color-mix(in srgb, var(--ink) 35%, transparent);
  }
  .built-name { padding: 0 6px; font-weight: 600; font-size: 0.875rem; line-height: 1.25; }
  @media (hover: hover) { .built-list a:hover { box-shadow: var(--shadow-card-hover); transform: translateY(-2px); } .built-list a:hover .built-name { color: var(--orange); } }
  @media (min-width: 640px) { .built-list { grid-template-columns: repeat(3, minmax(0, 1fr)); } }

  .role-head { display: flex; align-items: center; gap: 16px; }
  .brand { display: flex; align-items: center; justify-content: center; flex: none; width: 76px; height: 44px; }
  @media (min-width: 640px) { .brand { width: 112px; height: 60px; } }
  .brand :global(.brand-jv) { height: 46px; width: auto; }
  .brand :global(img) { max-width: 100%; max-height: 100%; width: auto; height: auto; object-fit: contain; }
  .mono {
    display: grid; place-items: center; flex: none; width: 96px; height: 56px; border-radius: 16px;
    background: var(--ink); color: var(--bg);
    font: 500 1.0625rem/1 var(--font-display); letter-spacing: -0.02em;
  }

  /* Bilingual roles: one compact card per client, logo first. */
  .extra { margin-top: clamp(40px, 6vw, 64px); }
  .extra-title { font-size: var(--step-h3); }
  .extra-sub { color: var(--muted); margin: 6px 0 22px; max-width: 52ch; }
  .clients { list-style: none; margin: 0; padding: 0; display: grid; gap: 12px; }
  .client {
    display: grid; grid-template-columns: 108px minmax(0, 1fr); gap: 16px; align-items: start;
    padding: 18px; background: var(--paper); border-radius: 22px; box-shadow: var(--shadow-card);
  }
  .client-logo { display: flex; align-items: center; height: 64px; }
  .client-logo :global(img) { width: 100%; max-height: 44px; height: auto; object-fit: contain; object-position: left center; }
  .e-role { font-weight: 600; line-height: 1.3; }
  .e-meta { margin-top: 4px; color: var(--muted); font-size: var(--step-small); }
  .e-period { color: var(--muted); font-size: 0.8125rem; font-variant-numeric: tabular-nums; margin-top: 2px; }
  .e-desc { color: var(--muted); font-size: var(--step-small); margin-top: 8px; line-height: 1.5; }
  .e-desc :global(p) { margin: 0; }

  /* Languages: one quiet row. */
  .langs {
    display: flex; flex-wrap: wrap; align-items: center; gap: 12px 28px;
    margin-top: 20px; padding-top: 20px; border-top: 1px solid var(--line);
  }
  .langs-title { font-size: 1rem; font-family: var(--font-body); font-weight: 600; letter-spacing: 0; }
  .langs ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 10px 28px; }
  .langs li { display: flex; align-items: center; gap: 10px; }
  .langs img { border-radius: 50%; box-shadow: 0 0 0 1px var(--line); }
  .langs b { font-weight: 600; margin-right: 6px; }
  .langs small { color: var(--muted); font-size: var(--step-small); }

  @media (min-width: 900px) {
    .clients { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }
    .client { grid-template-columns: 1fr; align-content: start; padding: 22px; gap: 12px; }
    .client-logo { height: 64px; }
    .client-logo :global(img) { width: 160px; max-height: 52px; }
  }

  @media (min-width: 860px) {
    .role { grid-template-columns: 220px minmax(0, 1fr); }
    .period { padding-top: 6px; }
  }
  @media (min-width: 860px) {
    .exp-head { grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr); }
  }
</style>
