---
import JVMark from './JVMark.astro';
import { Image } from 'astro:assets';
import { site } from '../data/site';
import nowShot from '../assets/projects/call-exchange/02.png';

import { ribbons, ribbonPoints, toPath, RW, RH } from '../lib/ribbon';

// Dark, logo-led hero (the intro hands its mark over to this one): the JV
// monogram, the name and one line, on ink with two drifting hairline ribbons
// and a faint construction dot grid behind the mark.
const bands = ribbons.map((r) => Array.from({ length: r.n }, (_, i) => toPath(ribbonPoints(r, i, 0))));
// A few strands in each band carry the accent.
const accent = (b: number, i: number) => (b === 0 ? i === 9 || i === 17 : i === 5);
---
<section id="top" class="hero" aria-labelledby="hero-title" data-hero>
  <div class="dots" aria-hidden="true"></div>
  <svg class="ribbon" viewBox={`0 0 ${RW} ${RH}`} preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false">
    {bands.map((paths, b) => (
      <g class={`band band-${b}`}>
        {paths.map((d, i) => <path class:list={{ hot: accent(b, i) }} d={d} />)}
      </g>
    ))}
  </svg>
  <div class="glow" aria-hidden="true"></div>

  <div class="container hero-in">
    <JVMark id="jv-hero" class="hero-mark" depth />
    <p class="name">{site.name}</p>
    <p class="role">{site.role}</p>
    <span class="rule" aria-hidden="true"></span>
    <h1 id="hero-title">I build the web applications businesses <span class="accent">run on.</span></h1>
    <div class="ctas">
      <a class="btn btn--light" href="#experience">
        See my experience
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
      </a>
      <a class="btn btn--line" href={site.cv} download>
        Download CV
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 4v12M6 11l6 6 6-6M5 20h14"/></svg>
      </a>
    </div>
  </div>

  <a class="cue" href="#statement" aria-label="Scroll to introduction">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 7l5 5 5-5M7 13l5 5 5-5"/></svg>
  </a>
</section>

<section id="statement" class="statement" aria-label="Introduction">
  <div class="container st-in">
    <p class="who"><span class="dot" aria-hidden="true"></span>Open to new projects</p>
    <p class="lead">
      Years of delivery for marketing agencies give me a sharp focus on lead generation,
      conversion and automation: SaaS and B2B platforms, POS systems, and the internal tools
      that keep operations moving.
    </p>
    <a class="now" href="#project-call-exchange" data-open="call-exchange">
      <span class="now-shot" aria-hidden="true">
        <Image src={nowShot} alt="" widths={[480, 800]} sizes="(min-width: 960px) 460px, 100vw" format="webp" quality={78} loading="lazy" />
      </span>
      <span class="now-body">
        <span class="now-tag"><span class="pulse" aria-hidden="true"></span>Now shipping</span>
        <span class="now-title">ProAxis Call Exchange</span>
        <span class="now-meta">Pay-per-call &amp; lead RTB · <b>$6k+</b> daily profit</span>
      </span>
      <svg class="now-go" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17L17 7M9 7h8v8"/></svg>
    </a>
    <ul class="proof" aria-label="Highlights">
      <li><b>30+</b> US locations run a POS I built</li>
      <li><b>1000s</b> of leads validated daily</li>
      <li><b>3+ yrs</b> shipping web and mobile</li>
    </ul>
    <p class="note">Prefer email? <a href={`mailto:${site.email}`}>{site.email}</a></p>
  </div>
</section>

<script>
  import { ribbons, ribbonPoints } from '../lib/ribbon';

  // The ribbons drift slowly while the hero is on screen; with a mouse, the
  // hairlines also part around the pointer like a comb and a faint warm light
  // follows it. Reduced motion keeps the still render.
  const hero = document.querySelector<HTMLElement>('[data-hero]');
  const ribbon = hero?.querySelector<SVGSVGElement>('.ribbon');
  const fine = matchMedia('(hover: hover) and (pointer: fine)').matches;
  const calm = matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (hero && ribbon && !calm) {
    const bands = [...ribbon.querySelectorAll('.band')].map((g) => [...g.querySelectorAll('path')]);
    const target = { x: 0, y: 0, f: 0 }; // f: how strongly the lines part (0..1)
    const now = { x: 0, y: 0, f: 0 };
    const sig2 = 2 * 130 * 130;
    const start = performance.now();
    let raf = 0, visible = false, last = 0;
    // Phones get ~30fps; the drift is slow enough that it doesn't show.
    const minGap = fine ? 0 : 30;

    const draw = (ts: number) => {
      raf = visible && !document.hidden ? requestAnimationFrame(draw) : 0;
      if (ts - last < minGap) return;
      last = ts;
      for (const key of ['x', 'y', 'f'] as const) now[key] += (target[key] - now[key]) * 0.14;
      const t = (ts - start) / 1000;
      ribbons.forEach((r, b) => bands[b].forEach((p, i) => {
        let d = '';
        for (const [x, y] of ribbonPoints(r, i, t)) {
          const dx = x - now.x, dy = y - now.y;
          const ny = now.f > 0.002 ? y + Math.tanh(dy / 40) * Math.exp(-(dx * dx + dy * dy) / sig2) * 70 * now.f : y;
          d += `${d ? 'L' : 'M'}${x.toFixed(1)} ${ny.toFixed(1)}`;
        }
        p.setAttribute('d', d);
      }));
    };
    const kick = () => { if (!raf && visible && !document.hidden) raf = requestAnimationFrame(draw); };
    new IntersectionObserver(([e]) => { visible = e.isIntersecting; kick(); }).observe(hero);
    document.addEventListener('visibilitychange', kick);

    if (fine) {
      hero.addEventListener('pointermove', (e) => {
        const ctm = ribbon.getScreenCTM();
        if (ctm) {
          const pt = new DOMPoint(e.clientX, e.clientY).matrixTransform(ctm.inverse());
          target.x = pt.x; target.y = pt.y;
          if (now.f < 0.01) { now.x = pt.x; now.y = pt.y; }
        }
        target.f = 1;
        const hr = hero.getBoundingClientRect();
        hero.style.setProperty('--gx', `${e.clientX - hr.left}px`);
        hero.style.setProperty('--gy', `${e.clientY - hr.top}px`);
        hero.setAttribute('data-pointer', '');
      });
      hero.addEventListener('pointerleave', () => {
        target.f = 0;
        hero.removeAttribute('data-pointer');
      });
    }
  }
</script>

<style>
  .hero {
    --on: #F2F0EB;
    position: relative; isolation: isolate; overflow: hidden;
    margin-top: calc(-1 * var(--nav-h));
    min-height: max(560px, 100svh);
    display: grid; place-items: center;
    padding: calc(var(--nav-h) + 24px) 0 88px;
    background: var(--ink); color: var(--on);
    text-align: center;
  }

  .ribbon { position: absolute; inset: 0; width: 100%; height: 100%; z-index: -1; }
  /* Pointer light: a faint warm glow that trails the cursor (fine pointers only). */
  .glow {
    position: absolute; inset: 0; z-index: -1; pointer-events: none; opacity: 0; transition: opacity 500ms ease-out;
    background: radial-gradient(420px circle at var(--gx, 50%) var(--gy, 50%), color-mix(in srgb, var(--orange) 9%, transparent), transparent 70%);
  }
  .hero[data-pointer] .glow { opacity: 1; }
  .ribbon path { fill: none; stroke: var(--on); stroke-opacity: 0.12; stroke-width: 1; vector-effect: non-scaling-stroke; }
  .band-1 path { stroke-opacity: 0.07; }
  .ribbon path.hot { stroke: var(--orange); stroke-opacity: 0.55; }
  .band-1 path.hot { stroke-opacity: 0.35; }
  /* Construction dot grid, strongest behind the mark and gone by the edges. */
  .dots {
    position: absolute; inset: 0; z-index: -1; pointer-events: none;
    background: radial-gradient(circle, color-mix(in srgb, var(--on) 16%, transparent) 1px, transparent 1.5px) center / 26px 26px;
    -webkit-mask: radial-gradient(ellipse 46% 52% at 50% 38%, #000, transparent);
    mask: radial-gradient(ellipse 46% 52% at 50% 38%, #000, transparent);
  }

  .hero-in { display: grid; justify-items: center; gap: 14px; }
  .hero-in :global(.hero-mark) { --jv-j: var(--on); width: clamp(110px, min(34vw, 21vh), 210px); height: auto; margin-bottom: 14px;
    filter: drop-shadow(0 22px 26px rgb(0 0 0 / 0.45)); }
  .name {
    font: 500 clamp(2.5rem, 1.6rem + 4vw, 4.5rem)/1 var(--font-display); letter-spacing: -0.04em;
  }
  .role {
    font-size: clamp(0.75rem, 0.7rem + 0.25vw, 0.875rem); font-weight: 600;
    letter-spacing: 0.28em; text-transform: uppercase;
    color: color-mix(in srgb, var(--on) 70%, transparent);
  }
  .rule { width: 56px; height: 1px; margin: 10px 0 6px; background: color-mix(in srgb, var(--on) 35%, transparent); }
  h1 {
    max-width: 20ch; color: var(--on);
    font-size: clamp(1.5rem, 1.05rem + 2vw, 2.5rem); font-weight: 400; line-height: 1.2; letter-spacing: -0.02em;
  }
  .accent { color: var(--orange); }

  .ctas { display: grid; gap: 10px; width: 100%; max-width: 360px; margin-top: 14px; }
  .btn--light { background: var(--on); color: var(--ink); }
  .btn--line { background: transparent; color: var(--on); box-shadow: inset 0 0 0 1.5px color-mix(in srgb, var(--on) 45%, transparent); }
  @media (hover: hover) {
    .btn--light:hover { background: #fff; }
    .btn--line:hover { background: color-mix(in srgb, var(--on) 10%, transparent); color: var(--on); }
  }
  .hero :global(:focus-visible) { outline-color: var(--on); }

  .cue {
    position: absolute; left: 50%; bottom: 22px; translate: -50% 0;
    display: grid; place-items: center; width: 44px; height: 44px; color: color-mix(in srgb, var(--on) 70%, transparent);
  }
  .cue svg { width: 22px; height: 22px; }
  @keyframes cue { 50% { transform: translateY(6px); } }

  /* Entrance: the hero copy rises after the mark (and waits for the intro). */
  .hero-in > * { animation: rise 760ms calc(var(--n, 0) * 90ms + 250ms) var(--ease-out) both; }
  .name { --n: 0; } .role { --n: 1; } .rule { --n: 2; } h1 { --n: 3; } .ctas { --n: 4; }
  .hero-in :global(.hero-mark) { animation: rise 700ms 100ms var(--ease-out) both; }
  .cue { animation: rise 760ms 900ms var(--ease-out) both, cue 2.4s 1.7s ease-in-out infinite; }
  @keyframes rise { from { opacity: 0; transform: translateY(16px); } }
  :global(.intro-on) .hero-in > *, :global(.intro-on) .cue { animation: none !important; opacity: 0; }
  :global(.intro-mark) .hero-in :global(.hero-mark) { animation: none !important; opacity: 0; }

  /* Statement band under the hero. */
  .statement { padding-block: clamp(48px, 7vw, 88px) 0; }
  .st-in { display: grid; gap: 22px; }
  .who {
    justify-self: start; display: inline-flex; align-items: center; gap: 10px;
    padding: 7px 14px 7px 11px; border-radius: 999px; border: 1px solid var(--line);
    font-size: var(--step-small); font-weight: 500;
  }
  .dot {
    flex: none; width: 8px; height: 8px; border-radius: 50%;
    background: var(--orange); box-shadow: 0 0 0 4px color-mix(in srgb, var(--orange) 22%, transparent);
  }
  .lead {
    max-width: 30ch; font-family: var(--font-display); font-weight: 400;
    font-size: clamp(1.5rem, 1.1rem + 1.8vw, 2.5rem); line-height: 1.25; letter-spacing: -0.025em;
  }
  .proof {
    display: grid; grid-template-columns: repeat(3, minmax(0, 1fr));
    margin: 4px 0 0; padding: 20px 0 0; list-style: none;
    border-top: 1px solid var(--line);
    color: var(--muted); font-size: 0.8125rem; line-height: 1.35;
  }
  .proof li { padding-inline: 12px; border-left: 1px solid var(--line); }
  .proof li:first-child { padding-left: 0; border-left: 0; }
  .proof b { display: block; margin-bottom: 4px; font: 500 1.5rem/1 var(--font-display); letter-spacing: -0.03em; color: var(--ink); }
  .note { color: var(--muted); font-size: var(--step-small); }

  /* "Now shipping" card: what I'm building right now, opens the project. */
  .now {
    position: relative; display: grid; text-decoration: none; overflow: hidden;
    border-radius: 22px; background: var(--paper); box-shadow: var(--shadow-card);
    transition: box-shadow 220ms ease-out, transform 220ms var(--ease-out);
  }
  .now-shot { display: block; aspect-ratio: 16 / 7.5; overflow: hidden; background: var(--surface); border-bottom: 1px solid var(--line); }
  .now-shot :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: top left; transition: transform 500ms var(--ease-out); }
  .now-body { display: grid; gap: 4px; padding: 16px 56px 18px 18px; }
  .now-tag {
    display: inline-flex; align-items: center; gap: 8px; justify-self: start;
    font-size: 0.75rem; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; color: var(--orange);
  }
  .pulse { width: 8px; height: 8px; border-radius: 50%; background: var(--orange); animation: pulse 2s ease-out infinite; }
  @keyframes pulse { 0% { box-shadow: 0 0 0 0 color-mix(in srgb, var(--orange) 45%, transparent); } 100% { box-shadow: 0 0 0 9px transparent; } }
  .now-title { font: 500 1.25rem/1.2 var(--font-display); letter-spacing: -0.02em; }
  .now-meta { color: var(--muted); font-size: var(--step-small); }
  .now-meta b { color: var(--ink); }
  .now-go {
    position: absolute; right: 16px; bottom: 18px; width: 36px; height: 36px; padding: 8px;
    border-radius: 50%; background: var(--ink); color: var(--bg);
  }
  @media (hover: hover) {
    .now:hover { box-shadow: var(--shadow-card-hover); transform: translateY(-3px); }
    .now:hover .now-shot :global(img) { transform: scale(1.03); }
  }
  @media (prefers-reduced-motion: reduce) { .pulse { animation: none; } }
  .note a { color: var(--ink); font-weight: 600; text-decoration-thickness: 1.5px; text-underline-offset: 3px; }

  @media (min-width: 560px) {
    .ctas { display: flex; justify-content: center; max-width: none; width: auto; }
    .proof { font-size: var(--step-small); }
    .proof li { padding-inline: 24px; }
    .proof b { font-size: 2rem; }
  }
  @media (min-width: 960px) {
    .st-in { grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr); column-gap: 64px; align-items: end; }
    .lead { grid-row: 2 / span 2; align-self: start; }
    .now { grid-column: 2; grid-row: 2; align-self: start; }
    .proof { grid-column: 2; grid-row: 3; }
    .who { grid-column: 1 / -1; }
    .proof { margin: 0; }
    .note { grid-column: 2; }
  }
  @media (prefers-reduced-motion: reduce) {
    .cue { animation: none; }
  }
</style>
