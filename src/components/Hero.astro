---
import Waves from './Waves.astro';
import Blob from './Blob.astro';
import AppMark from './AppMark.astro';
import { site } from '../data/site';
---
<section id="top" class="hero" aria-labelledby="hero-title">
  <div class="container hero-grid">
    <div class="scene" data-hero-scene aria-hidden="true">
      <Blob class="backdrop" seed={11} fill="color-mix(in srgb, var(--sky) 55%, var(--bg))" points={7} vary={0.26} />
      <Blob class="backdrop-2" seed={29} fill="var(--sun)" points={6} vary={0.3} />
      <!-- Flat twin of the 3D window, shown until the scene renders and kept when motion is reduced or WebGL is unavailable. -->
      <AppMark class="poster" />
      <canvas></canvas>
    </div>

    <div class="copy">
      <p class="who"><span class="dot" aria-hidden="true"></span><span>{site.role}<span class="status">, open to new projects</span></span></p>
      <h1 id="hero-title">
        I build the web applications businesses
        <span class="accent">run on.<svg viewBox="0 0 200 20" preserveAspectRatio="none" aria-hidden="true" focusable="false"><path d="M4 14 C 50 4, 120 2, 196 10" pathLength="1" /></svg></span>
      </h1>
      <p class="lead">
        Years of delivery for marketing agencies give me a sharp focus on lead generation,
        conversion and automation: SaaS and B2B platforms, POS systems, and the internal tools
        that keep operations moving.
      </p>
      <div class="ctas">
        <a class="btn" href="#work">
          See selected work
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </a>
        <a class="btn btn--ghost" href={site.cv} download>
          Download CV
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 4v12M6 11l6 6 6-6M5 20h14"/></svg>
        </a>
      </div>
      <ul class="proof" aria-label="Highlights">
        <li style="--c: var(--orange)"><b>30+</b> US locations run a POS I built</li>
        <li style="--c: var(--sun)"><b>1000s</b> of leads validated daily</li>
        <li style="--c: var(--leaf)"><b>3+ yrs</b> shipping web and mobile</li>
      </ul>
    </div>
  </div>

  <Waves
    seed={5}
    layers={[
      { fill: 'var(--sun)', base: 40, amp: 22 },
      { fill: 'var(--orange)', base: 74, amp: 20 },
      { fill: 'var(--bg)', base: 108, amp: 14, steps: 7 },
    ]}
  />
</section>

<style>
  /* Mobile first: a compact mark, then the message, full-width actions and a stat row. */
  .hero { position: relative; padding-top: 8px; overflow: hidden; }
  .hero-grid { display: grid; gap: 4px; padding-bottom: 12px; }
  .copy { display: grid; gap: 16px; min-width: 0; }

  .who {
    justify-self: start;
    display: inline-flex; align-items: center; gap: 10px;
    padding: 7px 14px 7px 12px; border-radius: 999px;
    background: var(--surface);
    font-size: var(--step-small); font-weight: 600; line-height: 1.3;
  }
  .dot {
    flex: none; width: 9px; height: 9px; border-radius: 50%;
    background: var(--leaf-ink); box-shadow: 0 0 0 4px color-mix(in srgb, var(--leaf) 60%, transparent);
  }
  .status { display: none; }

  .accent { position: relative; display: inline-block; white-space: nowrap; isolation: isolate; }
  .accent svg {
    position: absolute; left: -2%; bottom: -0.04em; z-index: -1;
    width: 104%; height: 0.32em; overflow: visible;
  }
  .accent path {
    fill: none; stroke: var(--orange); stroke-width: 7; stroke-linecap: round;
    stroke-dasharray: 1; stroke-dashoffset: 1;
    animation: draw 700ms 650ms var(--ease-out) forwards;
  }
  @keyframes draw { to { stroke-dashoffset: 0; } }

  /* Entrance: the copy rises in sequence; while the intro plays it waits. */
  .copy > * { animation: rise 640ms calc(var(--n, 0) * 70ms + 80ms) var(--ease-out) both; }
  .copy > :nth-child(2) { --n: 1; }
  .copy > :nth-child(3) { --n: 2; }
  .copy > :nth-child(4) { --n: 3; }
  .copy > :nth-child(5) { --n: 4; }
  @keyframes rise { from { opacity: 0; transform: translateY(18px); } }
  :global(.intro-on) .copy > *, :global(.intro-on) .accent path { animation: none; opacity: 0; }
  .scene { transition: opacity 450ms ease-out; }
  :global(.intro-mark) .scene { opacity: 0; }

  h1 { font-size: clamp(2.25rem, 1.1rem + 4.6vw, 2.75rem); line-height: 1.04; letter-spacing: -0.03em; max-width: 15ch; }
  .lead { color: var(--muted); font-size: 1.0625rem; line-height: 1.6; max-width: 52ch; }

  .ctas { display: grid; gap: 10px; margin-top: 4px; }
  .ctas .btn { width: 100%; }

  .proof {
    display: grid; grid-template-columns: repeat(3, minmax(0, 1fr));
    margin: 8px 0 0; padding: 18px 0 0; list-style: none;
    border-top: 1px solid var(--line);
    color: var(--muted); font-size: 0.8125rem; line-height: 1.35;
  }
  .proof li { padding-inline: 12px; border-left: 1px solid var(--line); }
  .proof li:first-child { padding-left: 0; border-left: 0; }
  .proof b::before {
    content: ""; position: absolute; left: 0; top: 0; width: 22px; height: 6px;
    border-radius: 999px; background: var(--c);
  }
  .proof b {
    position: relative; display: block; margin-bottom: 4px; padding-top: 14px;
    font: 600 1.5rem/1 var(--font-display); letter-spacing: -0.02em; color: var(--ink);
  }

  /* The 3D mark sits above the headline on phones, beside it on wide screens. */
  .scene { position: relative; order: -1; height: clamp(168px, 50vw, 260px); margin-inline: -8px; }
  .scene :global(.poster), .scene canvas { position: absolute; inset: 0; width: 100%; height: 100%; }
  /* Flat organic backdrop that gives the mark a colour mass to sit on. */
  .scene :global(.backdrop), .scene :global(.backdrop-2) {
    position: absolute; left: 50%; top: 50%; aspect-ratio: 1; width: auto; overflow: visible;
  }
  .scene :global(.backdrop) { height: 88%; translate: -50% -50%; }
  .scene :global(.backdrop-2) { height: 26%; translate: -250% 30%; }
  .scene :global(.poster) { padding: 0 12%; transition: opacity 400ms ease-out; }
  .scene canvas { opacity: 0; transition: opacity 500ms ease-out; }
  .scene[data-ready] canvas { opacity: 1; }
  .scene[data-ready] :global(.poster) { opacity: 0; }

  @media (min-width: 560px) {
    .status { display: inline; }
    .ctas { display: flex; flex-wrap: wrap; gap: 12px; }
    .ctas .btn { width: auto; }
    .proof { font-size: var(--step-small); }
    .proof li { padding-inline: 20px; }
    .proof b { font-size: 1.875rem; }
  }

  @media (min-width: 960px) {
    .hero { padding-top: clamp(20px, min(5vw, 5vh), 64px); }
    .hero-grid {
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
      align-items: center; gap: 40px; padding-bottom: 40px;
    }
    .copy { gap: clamp(14px, 2.4vh, 22px); }
    /* Width-based scale, capped by viewport height so the CTAs stay in the first screen on laptops. */
    h1 { font-size: clamp(3rem, min(1.6rem + 4.4vw, 9.5vh), 5.5rem); line-height: 1.02; }
    .lead { font-size: var(--step-lead); }
    .scene { order: 1; height: auto; aspect-ratio: 1 / 1; margin: 0; }
    .scene :global(.backdrop) { height: 74%; }
    .scene :global(.backdrop-2) { height: 20%; translate: -235% 95%; }
    .scene :global(.poster) { padding: 0; }
  }
</style>

<script>
  import { lazyScene } from '../scripts/lazy-scene';
  lazyScene('[data-hero-scene]', async () => (await import('../scripts/hero-scene')).mountHeroScene);
</script>
