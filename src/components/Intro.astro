---
import { site } from '../data/site';
import JVMark from './JVMark.astro';

// First-visit intro: the JV monogram is constructed on its own grid (Sentra
// style): the stem slides down its diagonal, the bowl swings in, the blade
// falls; then the name rises, then the mark flies into the nav logo while the
// screen fades away.
const letters = [...site.name];
// Construction lines, in the mark's own units (viewBox 8 0 90 100).
const vx = [8, 14, 32, 38, 56, 74, 98];
const hy = [0, 72, 100];
---
<script is:inline>
  // Decide before first paint, so the page never flashes under the intro.
  // Once per browser; ?intro forces it; skipped when motion is reduced.
  (function () {
    var d = document.documentElement;
    try {
      var force = /[?&#]intro\b/.test(location.search + location.hash);
      var seen = localStorage.getItem('jv-intro');
      var calm = matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (force || (!seen && !calm)) d.classList.add('intro-on', 'intro-mark');
    } catch (e) {}
  })();
</script>

<div class="splash" data-intro aria-hidden="true">
  <div class="stage">
    <div class="plate">
      <svg class="guides" viewBox="8 0 90 100" focusable="false">
        {hy.map((y, i) => <line class="gh" style={`--i: ${i}`} x1="-400" x2="500" y1={y} y2={y} />)}
        {vx.map((x, i) => <line class="gv" style={`--i: ${i}`} x1={x} x2={x} y1="-300" y2="400" />)}
      </svg>
      <JVMark id="jv-intro" class="mark" />
    </div>
    <p class="name">
      {letters.map((c, i) => <span style={`--i: ${i}`}>{c === ' ' ? ' ' : c}</span>)}
    </p>
    <p class="role">{site.role}</p>
  </div>
  <button class="skip" type="button" tabindex="-1">Skip intro</button>
</div>

<style is:global>
  .splash { display: none; }
  .intro-on body { overflow: hidden; }
  .intro-mark .nav .logo-mark { opacity: 0; }

  .intro-on .splash, .splash.leaving {
    position: fixed; inset: 0; z-index: 200; display: grid; place-items: center; cursor: pointer;
    background: var(--bg); overflow: hidden;
  }
  .splash .stage { display: grid; justify-items: center; gap: 6px; text-align: center; }
  .splash .plate { position: relative; width: min(36vw, 190px, 26vh * 0.9); margin-bottom: 30px; }
  .splash .mark, .splash .guides { display: block; width: 100%; height: auto; overflow: visible; }
  .splash .mark { position: relative; transform-origin: 0 0; }
  .splash .guides { position: absolute; inset: 0; }
  .splash .guides line {
    stroke: var(--orange); stroke-opacity: 0.45; stroke-width: 1px; vector-effect: non-scaling-stroke;
  }
  .splash .name {
    overflow: hidden;
    font: 500 clamp(2rem, 1.4rem + 3vw, 3.5rem)/1.1 var(--font-display); letter-spacing: -0.04em; color: var(--ink);
    text-transform: lowercase;
  }
  .splash .name span { display: inline-block; transform: translateY(130%); }
  .splash .role {
    color: var(--muted); font-weight: 600; font-size: 0.8125rem; letter-spacing: 0.18em; text-transform: uppercase;
    opacity: 0;
  }
  .splash .skip {
    position: absolute; right: max(16px, env(safe-area-inset-right)); bottom: calc(16px + env(safe-area-inset-bottom));
    padding: 10px 8px; border: 0; background: none; cursor: pointer;
    color: var(--muted); font: 600 0.875rem/1 var(--font-body);
    opacity: 0; transition: opacity 300ms ease-out 600ms;
  }

  /* Construction. Every part starts hidden and plays once .play is set. */
  .splash .mark path { transform-box: view-box; }
  .splash .gh { transform-box: fill-box; transform-origin: center; transform: scaleX(0); }
  .splash .gv { transform-box: fill-box; transform-origin: center; transform: scaleY(0); }
  .splash .jv-stem { transform: translate(-18px, -72px); opacity: 0; }
  .splash .jv-bowl { transform-origin: 32px 72px; transform: rotate(-180deg); opacity: 0; }
  .splash .jv-arm { clip-path: inset(0 0 100% 0); }

  .splash.play .skip { opacity: 1; }
  .splash.play .gh { animation: jv-line 700ms calc(var(--i) * 70ms) cubic-bezier(0.6, 0, 0.2, 1) forwards; }
  .splash.play .gv { animation: jv-line 700ms calc(120ms + var(--i) * 45ms) cubic-bezier(0.6, 0, 0.2, 1) forwards; }
  .splash.play .jv-stem { animation: jv-in 560ms 420ms cubic-bezier(0.7, 0, 0.2, 1) forwards; }
  .splash.play .jv-bowl { animation: jv-in 640ms 820ms cubic-bezier(0.3, 1.25, 0.4, 1) forwards; }
  .splash.play .jv-arm { animation: jv-wipe 760ms 1.1s cubic-bezier(0.6, 0, 0.2, 1) forwards; }
  .splash.play .name span { animation: jv-in 640ms calc(1.45s + var(--i) * 40ms) cubic-bezier(0.2, 0.8, 0.2, 1) forwards; }
  .splash.play .role { animation: jv-track 700ms 1.85s cubic-bezier(0.2, 0.8, 0.2, 1) forwards; }

  /* Skipping jumps the construction to its end state before the exit plays. */
  .splash.fast * { animation-duration: 0.01ms !important; animation-delay: 0s !important; }

  @keyframes jv-line { to { transform: none; } }
  @keyframes jv-in { to { transform: none; opacity: 1; } }
  @keyframes jv-wipe { to { clip-path: inset(0); } }
  @keyframes jv-track {
    from { opacity: 0; letter-spacing: 0.4em; }
    to { opacity: 1; letter-spacing: 0.18em; }
  }
</style>

<script>
  const intro = document.querySelector<HTMLElement>('[data-intro]');
  const root = document.documentElement;

  if (intro && root.classList.contains('intro-on')) {
    try { localStorage.setItem('jv-intro', '1'); } catch {}
    if ('scrollRestoration' in history) history.scrollRestoration = 'manual';
    window.scrollTo(0, 0);

    const mark = intro.querySelector<SVGSVGElement>('.mark')!;
    const ease = 'cubic-bezier(0.7, 0, 0.2, 1)';
    let ended = false;
    let timer = 0;

    const done = () => {
      root.classList.remove('intro-mark');
      intro.remove();
    };

    const finish = () => {
      if (ended) return;
      ended = true;
      clearTimeout(timer);

      // Measure the nav logo while the nav is still at rest, then let the page in.
      const target = document.querySelector('.nav .logo-mark')?.getBoundingClientRect();
      intro.classList.add('leaving');
      root.classList.remove('intro-on');

      const fade = (el: Element, ms: number, delay = 0) =>
        el.animate([{ opacity: getComputedStyle(el).opacity }, { opacity: 0 }], { duration: ms, delay, fill: 'forwards' }).finished;
      intro.querySelectorAll('.guides, .name, .role, .skip').forEach((el) => fade(el, 260));

      // The backdrop fades while the mark keeps flying, so the mark is the last thing to land.
      const bg = intro.animate([{ backgroundColor: getComputedStyle(intro).backgroundColor }, { backgroundColor: 'transparent' }], { duration: 650, delay: 280, fill: 'forwards' }).finished;
      const runs: Promise<unknown>[] = [bg];
      if (target && target.width) {
        const r = mark.getBoundingClientRect();
        runs.push(
          mark.animate(
            [{ transform: 'none' }, { transform: `translate(${target.left - r.left}px, ${target.top - r.top}px) scale(${target.width / r.width})` }],
            { duration: 950, easing: ease, fill: 'forwards' },
          ).finished,
        );
      }
      Promise.all(runs).then(done, done);
    };

    const skip = () => {
      intro.classList.add('fast');
      requestAnimationFrame(finish);
    };

    // Wait for the display font so the name doesn't reflow mid-animation (max 1.5s).
    Promise.race([document.fonts.ready, new Promise((r) => setTimeout(r, 1500))]).then(() => {
      requestAnimationFrame(() => intro.classList.add('play'));
      timer = window.setTimeout(finish, 2700);
    });

    intro.addEventListener('click', skip);
    addEventListener('keydown', (e) => { if (!ended && ['Escape', 'Enter', ' '].includes(e.key)) skip(); });
    addEventListener('wheel', skip, { once: true, passive: true });
    addEventListener('touchmove', skip, { once: true, passive: true });
  } else {
    intro?.remove();
  }
</script>
