---
import { site } from '../data/site';
import JVMark from './JVMark.astro';

// Intro: on the hero's own ink, particles stream in from every edge and
// assemble into the JV monogram, the solid mark takes over and the name rises.
// On exit the screen dissolves into the hero while the mark lands on the hero's.
const letters = [...site.name];
---
<script is:inline>
  // Decide before first paint, so the page never flashes under the intro.
  // Plays on every load. Skipped when motion is reduced or when the link
  // points straight at a section or project (e.g. #project-proaxis);
  // ?intro forces it either way.
  (function () {
    var d = document.documentElement;
    try {
      var force = /[?&#]intro\b/.test(location.search + location.hash);
      var calm = matchMedia('(prefers-reduced-motion: reduce)').matches;
      var deep = location.hash.length > 1;
      if (force || (!calm && !deep)) d.classList.add('intro-on', 'intro-mark');
    } catch (e) {}
  })();
</script>

<div class="splash" data-intro aria-hidden="true">
  <canvas class="dust"></canvas>
  <div class="stage">
    <div class="plate">
      <JVMark id="jv-intro" class="mark" />
    </div>
    <p class="name">
      {letters.map((c, i) => <span style={`--i: ${i}`}>{c === ' ' ? ' ' : c}</span>)}
    </p>
    <p class="role">{site.role}</p>
  </div>
  <button class="skip" type="button" tabindex="-1">Skip intro</button>
</div>

<style is:global>
  .splash { display: none; }
  .intro-on body { overflow: hidden; }
  .intro-played .hero-mark { animation: none !important; }

  .intro-on .splash, .splash.leaving {
    --on: #F2F0EB;
    position: fixed; inset: 0; z-index: 200; display: grid; place-items: center; cursor: pointer;
    background: var(--ink); overflow: hidden;
  }
  .splash .dust { position: absolute; inset: 0; width: 100%; height: 100%; transition: opacity 500ms ease-out; }
  .splash .stage { position: relative; display: grid; justify-items: center; gap: 6px; text-align: center; }
  .splash .plate { position: relative; width: min(36vw, 190px, 26vh * 0.9); margin-bottom: 30px; }
  .splash .mark { --jv-j: var(--on); display: block; width: 100%; height: auto; overflow: visible; transform-origin: 0 0; opacity: 0; }
  .splash .name {
    overflow: hidden;
    font: 500 clamp(2rem, 1.4rem + 3vw, 3.5rem)/1.1 var(--font-display); letter-spacing: -0.04em; color: var(--on);
  }
  .splash .name span { display: inline-block; transform: translateY(130%); }
  .splash .role {
    color: color-mix(in srgb, var(--on) 70%, transparent); font-weight: 600; font-size: 0.8125rem; letter-spacing: 0.18em; text-transform: uppercase;
    opacity: 0;
  }
  .splash .skip {
    position: absolute; right: max(16px, env(safe-area-inset-right)); bottom: calc(16px + env(safe-area-inset-bottom));
    padding: 10px 8px; border: 0; background: none; cursor: pointer;
    color: color-mix(in srgb, var(--on) 60%, transparent); font: 600 0.875rem/1 var(--font-body);
    opacity: 0; transition: opacity 300ms ease-out 600ms;
  }

  /* Once the particles have landed the solid mark takes over, then the name rises. */
  .splash.play .skip { opacity: 1; }
  .splash.formed .mark { animation: jv-in 420ms ease-out forwards; }
  .splash.formed .dust { opacity: 0; }
  .splash.formed .name span { animation: jv-rise 640ms calc(150ms + var(--i) * 40ms) cubic-bezier(0.2, 0.8, 0.2, 1) forwards; }
  .splash.formed .role { animation: jv-track 700ms 550ms cubic-bezier(0.2, 0.8, 0.2, 1) forwards; }

  /* Skipping jumps straight to the end state before the exit plays. */
  .splash.fast * { animation-duration: 0.01ms !important; animation-delay: 0s !important; transition: none !important; }

  @keyframes jv-in { to { opacity: 1; } }
  @keyframes jv-rise { to { transform: none; } }
  @keyframes jv-track {
    from { opacity: 0; letter-spacing: 0.4em; }
    to { opacity: 1; letter-spacing: 0.18em; }
  }
</style>

<script>
  // Particles fly in from beyond the edges as short streaks and land on points
  // sampled from the mark's own shapes; resolves once the last one has landed.
  function assemble(canvas: HTMLCanvasElement, mark: SVGSVGElement, stopped: () => boolean) {
    const dpr = Math.min(devicePixelRatio || 1, 2);
    const W = innerWidth, H = innerHeight;
    canvas.width = W * dpr; canvas.height = H * dpr;
    const ctx = canvas.getContext('2d')!;
    ctx.scale(dpr, dpr);

    // Rasterise the mark where it sits and sample a grid of points from it.
    const box = mark.getBoundingClientRect();
    const k = box.width / 90;
    const off = document.createElement('canvas');
    off.width = Math.ceil(box.width); off.height = Math.ceil(box.height);
    const o = off.getContext('2d', { willReadFrequently: true })!;
    o.setTransform(k, 0, 0, k, -8 * k, 0);
    o.fillStyle = '#f00';
    o.fill(new Path2D('M14 0H38L56.25 73H32.25Z')); o.fill(new Path2D('M56 72A24 24 0 0 1 8 72Z'));
    const blade = o.createLinearGradient(88, 4, 50, 96);
    blade.addColorStop(0, 'rgba(0,0,255,1)'); blade.addColorStop(0.55, 'rgba(0,0,255,.55)'); blade.addColorStop(1, 'rgba(0,0,255,0)');
    o.fillStyle = blade;
    o.fill(new Path2D('M74 0H98L64 100H42Z'));
    const px = o.getImageData(0, 0, off.width, off.height).data;

    const css = getComputedStyle(canvas);
    const on = css.getPropertyValue('--on').trim() || '#F2F0EB';
    const orange = css.getPropertyValue('--orange').trim() || '#F47B3B';
    const step = Math.max(3, Math.round(box.width / 40));
    const R = Math.hypot(W, H) * 0.6;
    const cx = W / 2, cy = H / 2;
    type P = { x: number; y: number; sx: number; sy: number; bend: number; t0: number; dur: number; c: string; a: number; size: number; land: boolean };
    const ps: P[] = [];
    const launch = (x: number, y: number, c: string, a: number, land: boolean, t0: number, dur: number) => {
      const ang = Math.random() * Math.PI * 2, dist = R * (0.75 + Math.random() * 0.5);
      ps.push({ x, y, sx: cx + Math.cos(ang) * dist, sy: cy + Math.sin(ang) * dist, bend: (Math.random() - 0.5) * 0.5,
        t0, dur, c, a, size: land ? step * 0.42 : 1, land });
    };
    for (let y = step / 2; y < off.height; y += step) {
      for (let x = step / 2; x < off.width; x += step) {
        const i = (Math.round(y) * off.width + Math.round(x)) * 4;
        const alpha = px[i + 3] / 255;
        if (alpha < 0.12) continue;
        const isJ = px[i] > px[i + 2];
        // Points nearer the centre of the mark land last, so it fills in from the outside.
        const d = Math.hypot(x - off.width / 2, y - off.height / 2) / off.width;
        launch(box.left + x, box.top + y, isJ ? on : orange, isJ ? 1 : alpha, true, 80 + Math.random() * 520 - d * 200, 950 + Math.random() * 450);
      }
    }
    // Dust that streams through the centre and never lands.
    for (let n = 0; n < Math.round(W * H / 14000); n++) {
      launch(cx + (Math.random() - 0.5) * W * 0.5, cy + (Math.random() - 0.5) * H * 0.5, Math.random() < 0.4 ? orange : on, 0.5, false, Math.random() * 900, 900 + Math.random() * 700);
    }
    const end = Math.max(...ps.filter((p) => p.land).map((p) => p.t0 + p.dur));
    const ease = (t: number) => 1 - Math.pow(1 - t, 3);
    const at = (p: P, t: number) => {
      const e = ease(t), dx = p.x - p.sx, dy = p.y - p.sy, s = Math.sin(Math.PI * e) * p.bend;
      return [p.sx + dx * e - dy * s, p.sy + dy * e + dx * s];
    };

    return new Promise<void>((resolve) => {
      const start = performance.now();
      const frame = (now: number) => {
        if (stopped()) return resolve();
        const el = now - start;
        ctx.clearRect(0, 0, W, H);
        ctx.lineCap = 'round';
        for (const p of ps) {
          const t = (el - p.t0) / p.dur;
          if (t <= 0 || (!p.land && t >= 1)) continue;
          const tc = Math.min(t, 1);
          const [x, y] = at(p, tc);
          const fade = p.land ? Math.min(1, t * 3) : Math.sin(Math.PI * tc);
          ctx.globalAlpha = p.a * fade;
          ctx.strokeStyle = ctx.fillStyle = p.c;
          if (tc < 1) {
            // A short tail behind the head, capped so fast particles read as dots, not lines.
            const [tx, ty] = at(p, Math.max(0, tc - 0.03));
            const len = Math.hypot(x - tx, y - ty), cap = Math.min(1, 22 / (len || 1));
            ctx.lineWidth = 1;
            ctx.globalAlpha *= 0.55;
            ctx.beginPath(); ctx.moveTo(x + (tx - x) * cap, y + (ty - y) * cap); ctx.lineTo(x, y); ctx.stroke();
            ctx.globalAlpha /= 0.55;
          }
          ctx.beginPath(); ctx.arc(x, y, p.land ? p.size * (0.6 + 0.4 * tc) : 1, 0, Math.PI * 2); ctx.fill();
        }
        if (el < end + 120) requestAnimationFrame(frame);
        else resolve();
      };
      requestAnimationFrame(frame);
    });
  }

  const intro = document.querySelector<HTMLElement>('[data-intro]');
  const root = document.documentElement;

  if (intro && root.classList.contains('intro-on')) {
    if ('scrollRestoration' in history) history.scrollRestoration = 'manual';
    window.scrollTo(0, 0);

    const mark = intro.querySelector<SVGSVGElement>('.mark')!;
    const ease = 'cubic-bezier(0.7, 0, 0.2, 1)';
    let ended = false;
    let timer = 0;

    const done = () => {
      root.classList.add('intro-played');
      root.classList.remove('intro-mark');
      intro.remove();
    };

    const finish = () => {
      if (ended) return;
      ended = true;
      clearTimeout(timer);

      // Measure the hero's mark while it is still at rest, then let the page in.
      const target = document.querySelector('.hero-mark')?.getBoundingClientRect();
      intro.classList.add('leaving');
      root.classList.remove('intro-on');

      const fade = (el: Element, ms: number, delay = 0) =>
        el.animate([{ opacity: getComputedStyle(el).opacity }, { opacity: 0 }], { duration: ms, delay, fill: 'forwards' }).finished;
      intro.querySelectorAll('.dust, .name, .role, .skip').forEach((el) => fade(el, 260));

      // The backdrop fades while the mark keeps flying, so the mark is the last thing to land.
      const bg = intro.animate([{ backgroundColor: getComputedStyle(intro).backgroundColor }, { backgroundColor: 'transparent' }], { duration: 800, delay: 150, fill: 'forwards' }).finished;
      const runs: Promise<unknown>[] = [bg];
      if (target && target.width) {
        const r = mark.getBoundingClientRect();
        runs.push(
          mark.animate(
            [{ transform: 'none' }, { transform: `translate(${target.left - r.left}px, ${target.top - r.top}px) scale(${target.width / r.width})` }],
            { duration: 950, easing: ease, fill: 'forwards' },
          ).finished,
        );
      }
      Promise.all(runs).then(done, done);
    };

    const skip = () => {
      intro.classList.add('fast', 'formed');
      requestAnimationFrame(finish);
    };

    // Wait for the display font so the name doesn't reflow mid-animation (max 1.5s).
    Promise.race([document.fonts.ready, new Promise((r) => setTimeout(r, 1500))]).then(() => {
      if (ended) return;
      intro.classList.add('play');
      const landed = assemble(intro.querySelector('canvas')!, mark, () => ended);
      landed.then(() => {
        if (ended) return;
        intro.classList.add('formed');
        timer = window.setTimeout(finish, 1250);
      });
    });

    intro.addEventListener('click', skip);
    addEventListener('keydown', (e) => { if (!ended && ['Escape', 'Enter', ' '].includes(e.key)) skip(); });
    addEventListener('wheel', skip, { once: true, passive: true });
    addEventListener('touchmove', skip, { once: true, passive: true });
  } else {
    intro?.remove();
  }
</script>
