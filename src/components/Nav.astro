---
import { site } from '../data/site';
---
<header class="nav" data-nav>
  <div class="container nav-in">
    <a class="logo" href="#top" aria-label={`${site.name}, back to top`}>{site.name}</a>
    <nav id="primary-nav" aria-label="Primary">
      <ul>
        {site.nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
      </ul>
    </nav>
    <a class="btn nav-cta" href="#contact">Get in touch</a>
    <button class="menu-btn" type="button" aria-expanded="false" aria-controls="primary-nav" data-menu-btn>
      <span class="visually-hidden">Menu</span>
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true">
        <path class="bar bar-1" d="M4 8h16" />
        <path class="bar bar-2" d="M4 16h16" />
      </svg>
    </button>
  </div>
</header>

<style>
  .nav {
    position: sticky; top: 0; z-index: 40;
    background: var(--bg);
    border-bottom: 1px solid transparent;
    transition: border-color 200ms ease-out;
  }
  :global(body[data-scrolled]) .nav,
  .nav[data-open] { border-bottom-color: var(--line); }
  .nav-in { position: relative; display: flex; align-items: center; gap: 8px; min-height: 64px; }
  .logo {
    margin-right: auto;
    font-family: var(--font-display); font-weight: 600; font-size: 1.25rem;
    letter-spacing: -0.02em; text-decoration: none; white-space: nowrap;
  }
  ul { display: flex; gap: 6px; list-style: none; margin: 0; padding: 0; }
  nav a {
    display: flex; align-items: center; min-height: 44px; padding: 0 14px;
    border-radius: 999px; color: var(--muted); font-weight: 500; text-decoration: none;
    transition: color 160ms ease-out, background-color 160ms ease-out;
  }
  nav a[aria-current="true"] { color: var(--ink); background: var(--surface); }
  @media (hover: hover) { nav a:hover { color: var(--ink); background: var(--surface); } }

  .nav-cta { min-height: 44px; padding: 0 18px; font-size: 0.9375rem; }

  .menu-btn {
    display: grid; place-items: center; width: 44px; height: 44px; flex: none;
    border: 0; border-radius: 999px; background: var(--surface); color: var(--ink); cursor: pointer;
  }
  .bar { transition: transform 200ms var(--ease-out); transform-origin: 12px 12px; }
  .menu-btn[aria-expanded="true"] .bar-1 { transform: translateY(4px) rotate(45deg); }
  .menu-btn[aria-expanded="true"] .bar-2 { transform: translateY(-4px) rotate(-45deg); }

  /* Phones: links drop down as a full-width sheet under the bar. */
  nav {
    position: absolute; top: 100%; left: 0; right: 0;
    padding: 8px var(--gutter) 20px;
    background: var(--bg); border-bottom: 1px solid var(--line);
    box-shadow: 0 16px 24px -16px color-mix(in srgb, var(--ink) 25%, transparent);
    visibility: hidden; opacity: 0; transform: translateY(-8px);
    transition: opacity 180ms ease-out, transform 180ms var(--ease-out), visibility 0s linear 180ms;
  }
  .nav[data-open] nav {
    visibility: visible; opacity: 1; transform: none;
    transition: opacity 180ms ease-out, transform 180ms var(--ease-out);
  }
  nav ul { flex-direction: column; gap: 2px; }
  nav a { min-height: 52px; padding: 0 16px; font-size: 1.125rem; color: var(--ink); }

  @media (max-width: 359px) { .nav-cta { display: none; } }

  @media (min-width: 820px) {
    .nav-in { gap: 24px; min-height: 76px; }
    .logo { font-size: 1.375rem; }
    .menu-btn { display: none; }
    nav {
      position: static; padding: 0; background: none; border: 0; box-shadow: none;
      visibility: visible; opacity: 1; transform: none; transition: none;
    }
    nav ul { flex-direction: row; gap: 6px; }
    nav a { min-height: 44px; padding: 0 14px; font-size: inherit; color: var(--muted); }
    .nav-cta { margin-left: 8px; padding: 0 20px; font-size: 1rem; }
  }
</style>

<script>
  const body = document.body;
  const header = document.querySelector<HTMLElement>('[data-nav]')!;
  const menuBtn = header.querySelector<HTMLButtonElement>('[data-menu-btn]')!;
  const links = [...header.querySelectorAll<HTMLAnchorElement>('nav a')];

  const onScroll = () => body.toggleAttribute('data-scrolled', window.scrollY > 8);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  // Mobile menu: toggle, close on link, Escape or a tap outside.
  const setOpen = (open: boolean) => {
    header.toggleAttribute('data-open', open);
    menuBtn.setAttribute('aria-expanded', String(open));
  };
  menuBtn.addEventListener('click', () => setOpen(!header.hasAttribute('data-open')));
  links.forEach((a) => a.addEventListener('click', () => setOpen(false)));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && header.hasAttribute('data-open')) {
      setOpen(false);
      menuBtn.focus();
    }
  });
  document.addEventListener('click', (e) => {
    if (header.hasAttribute('data-open') && !header.contains(e.target as Node)) setOpen(false);
  });
  matchMedia('(min-width: 820px)').addEventListener('change', () => setOpen(false));

  // Mark the nav link for the section currently in view.
  const sections = links
    .map((a) => document.querySelector<HTMLElement>(a.getAttribute('href') ?? ''))
    .filter((s): s is HTMLElement => !!s);
  const io = new IntersectionObserver(
    (entries) => {
      for (const e of entries) {
        if (!e.isIntersecting) continue;
        links.forEach((a) => a.setAttribute('aria-current', String(a.getAttribute('href') === `#${e.target.id}`)));
      }
    },
    { rootMargin: '-45% 0px -50% 0px' },
  );
  sections.forEach((s) => io.observe(s));
</script>
