---
import { site } from '../data/site';
import JVMark from './JVMark.astro';
---
<header class="nav" data-nav>
  <div class="container">
    <div class="bar">
      <a class="logo" href="#top" aria-label={`${site.name}, back to top`}>
        <JVMark id="jv-nav" class="logo-mark" />
        {site.name}
      </a>
      <nav id="primary-nav" aria-label="Primary">
        <ul>
          {site.nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
        </ul>
      </nav>
      <a class="btn nav-cta" href="#contact">Get in touch</a>
      <button class="menu-btn" type="button" aria-expanded="false" aria-controls="primary-nav" data-menu-btn>
        <span class="visually-hidden">Menu</span>
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true">
          <path class="line line-1" d="M4 8h16" />
          <path class="line line-2" d="M4 16h16" />
        </svg>
      </button>
    </div>
  </div>
</header>

<style>
  /*
    At the top the bar is part of the hero: no fill, no border.
    Once scrolled it becomes a floating frosted pill, hides while reading
    down and comes back as soon as the visitor scrolls up.
  */
  .nav {
    position: sticky; top: 0; z-index: 40;
    padding-top: 8px;
    transition: transform 360ms var(--ease-out);
    animation: nav-in 600ms 120ms var(--ease-out) backwards;
  }
  .nav[data-hidden]:not([data-open]) { transform: translateY(calc(-100% - 8px)); }
  :global(.intro-on) .nav { animation: none; opacity: 0; }
  @keyframes nav-in { from { opacity: 0; transform: translateY(-12px); } }

  .bar {
    position: relative; display: flex; align-items: center; gap: 8px;
    min-height: 56px; margin-inline: -8px; padding: 6px 6px 6px 8px;
    border: 1px solid transparent; border-radius: 999px;
    transition: background-color 260ms ease-out, border-color 260ms ease-out, box-shadow 260ms ease-out, padding 260ms var(--ease-out);
  }
  .nav[data-scrolled] .bar, .nav[data-open] .bar {
    padding-left: 18px;
    background: color-mix(in srgb, var(--bg) 92%, transparent);
    border-color: color-mix(in srgb, var(--ink) 10%, transparent);
    box-shadow: 0 10px 30px -14px color-mix(in srgb, var(--ink) 30%, transparent);
    -webkit-backdrop-filter: blur(14px) saturate(1.4);
    backdrop-filter: blur(14px) saturate(1.4);
  }

  .logo {
    display: inline-flex; align-items: center; gap: 10px; margin-right: auto;
    min-height: 44px; border-radius: 999px;
    font-family: var(--font-display); font-weight: 500; font-size: 1.25rem;
    letter-spacing: -0.035em; text-decoration: none; white-space: nowrap;
  }
  .logo :global(.logo-mark) { width: 24px; height: auto; flex: none; }

  ul { display: flex; gap: 2px; list-style: none; margin: 0; padding: 0; }
  nav a {
    position: relative; display: flex; align-items: center; min-height: 44px; padding: 0 14px;
    border-radius: 999px; color: var(--muted); font-weight: 500; text-decoration: none;
    transition: color 160ms ease-out, background-color 160ms ease-out;
  }
  nav a[aria-current="true"] { color: var(--ink); }
  @media (hover: hover) { nav a:hover { color: var(--ink); } }

  .nav-cta { min-height: 44px; padding: 0 18px; font-size: 0.9375rem; }

  .menu-btn {
    display: grid; place-items: center; width: 44px; height: 44px; flex: none;
    border: 0; border-radius: 999px; background: var(--surface); color: var(--ink); cursor: pointer;
  }
  .line { transition: transform 220ms var(--ease-out); transform-origin: 12px 12px; }
  .menu-btn[aria-expanded="true"] .line-1 { transform: translateY(4px) rotate(45deg); }
  .menu-btn[aria-expanded="true"] .line-2 { transform: translateY(-4px) rotate(-45deg); }

  /* Phones: the links open as a rounded card under the pill. */
  nav {
    position: absolute; top: calc(100% + 8px); left: 0; right: 0;
    padding: 8px; border-radius: 26px;
    background: var(--bg); border: 1px solid color-mix(in srgb, var(--ink) 10%, transparent);
    box-shadow: 0 24px 48px -20px color-mix(in srgb, var(--ink) 35%, transparent);
    visibility: hidden; opacity: 0; transform: translateY(-6px) scale(0.98); transform-origin: top center;
    transition: opacity 180ms ease-out, transform 220ms var(--ease-out), visibility 0s linear 220ms;
  }
  .nav[data-open] nav {
    visibility: visible; opacity: 1; transform: none;
    transition: opacity 180ms ease-out, transform 220ms var(--ease-out);
  }
  nav ul { flex-direction: column; }
  nav a { min-height: 52px; padding: 0 18px; font-size: 1.125rem; color: var(--ink); }
  nav a[aria-current="true"] { background: var(--surface); }

  /* Over the dark hero: no fill, light text, and no logo (the hero carries it). */
  .logo { transition: opacity 260ms ease-out, visibility 0s; }
  .nav[data-dark]:not([data-open]) .logo { opacity: 0; visibility: hidden; transition: opacity 200ms ease-out, visibility 0s 200ms; }
  .nav[data-dark] .nav-cta { background: #F4EFE7; color: var(--ink); }
  .nav[data-dark] .menu-btn { background: color-mix(in srgb, #F4EFE7 14%, transparent); color: #F4EFE7; }
  .nav[data-dark] :global(:focus-visible) { outline-color: #F4EFE7; }

  @media (max-width: 359px) { .nav-cta { display: none; } }

  @media (min-width: 820px) {
    .nav { padding-top: 12px; }
    .bar { min-height: 60px; gap: 20px; }
    .logo { font-size: 1.3125rem; }
    .menu-btn { display: none; }
    nav {
      position: static; margin-left: auto; padding: 0; border: 0; border-radius: 0;
      background: none; box-shadow: none;
      visibility: visible; opacity: 1; transform: none; transition: none;
    }
    nav ul { flex-direction: row; }
    nav a { min-height: 44px; padding: 0 14px; font-size: 1rem; color: var(--muted); }
    /* Current section: a short colour bar under the label instead of a fill. */
    nav a::after {
      content: ""; position: absolute; left: 50%; bottom: 6px; width: 16px; height: 3px;
      border-radius: 999px; background: var(--orange);
      transform: translateX(-50%) scaleX(0); transition: transform 240ms var(--ease-out);
    }
    nav a[aria-current="true"] { background: none; }
    nav a[aria-current="true"]::after { transform: translateX(-50%) scaleX(1); }
    .logo { margin-right: 0; }
    .nav-cta { margin-left: 0; padding: 0 20px; font-size: 1rem; }
    .nav[data-dark] nav a { color: color-mix(in srgb, #F4EFE7 72%, transparent); }
    .nav[data-dark] nav a:hover { color: #F4EFE7; }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('[data-nav]')!;
  const menuBtn = header.querySelector<HTMLButtonElement>('[data-menu-btn]')!;
  const links = [...header.querySelectorAll<HTMLAnchorElement>('nav a')];

  // Pill once scrolled; hide on the way down, show on the way up.
  let lastY = window.scrollY;
  let ticking = false;
  const hero = document.querySelector<HTMLElement>('[data-hero]');
  const update = () => {
    const y = window.scrollY;
    // Dark while the hero still sits under the bar; the light pill takes over after it.
    const dark = !!hero && hero.getBoundingClientRect().bottom > header.offsetHeight;
    header.toggleAttribute('data-dark', dark);
    header.toggleAttribute('data-scrolled', !dark && y > 12);
    if (y < 160 || y < lastY - 4) header.removeAttribute('data-hidden');
    else if (y > lastY + 4) header.setAttribute('data-hidden', '');
    if (Math.abs(y - lastY) > 4) lastY = y;
    ticking = false;
  };
  update();
  window.addEventListener('scroll', () => {
    if (!ticking) { ticking = true; requestAnimationFrame(update); }
  }, { passive: true });
  // Keyboard users tabbing into the bar always get it back.
  header.addEventListener('focusin', () => header.removeAttribute('data-hidden'));

  // Mobile menu: toggle, close on link, Escape or a tap outside.
  const setOpen = (open: boolean) => {
    header.toggleAttribute('data-open', open);
    menuBtn.setAttribute('aria-expanded', String(open));
  };
  menuBtn.addEventListener('click', () => setOpen(!header.hasAttribute('data-open')));
  links.forEach((a) => a.addEventListener('click', () => setOpen(false)));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && header.hasAttribute('data-open')) {
      setOpen(false);
      menuBtn.focus();
    }
  });
  document.addEventListener('click', (e) => {
    if (header.hasAttribute('data-open') && !header.contains(e.target as Node)) setOpen(false);
  });
  matchMedia('(min-width: 820px)').addEventListener('change', () => setOpen(false));

  // Mark the nav link for the section currently in view.
  const sections = links
    .map((a) => document.querySelector<HTMLElement>(a.getAttribute('href') ?? ''))
    .filter((s): s is HTMLElement => !!s);
  const io = new IntersectionObserver(
    (entries) => {
      for (const e of entries) {
        if (!e.isIntersecting) continue;
        links.forEach((a) => a.setAttribute('aria-current', String(a.getAttribute('href') === `#${e.target.id}`)));
      }
    },
    { rootMargin: '-45% 0px -50% 0px' },
  );
  sections.forEach((s) => io.observe(s));
</script>
