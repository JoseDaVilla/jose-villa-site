---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';

interface Props { projects: CollectionEntry<'projects'>[] }
const { projects } = Astro.props;
const label = (p: CollectionEntry<'projects'>) => p.data.when ?? String(p.data.year);
---
<section id="more" class="more section" aria-labelledby="more-title">
  <div class="container">
    <div class="section-head">
      <h2 id="more-title">More work</h2>
      <p>Client sites, automation and 3D experiments. Some run live right inside the project window.</p>
    </div>

    <p class="swipe-hint" aria-hidden="true">
      Swipe to browse
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
    </p>
    <div class="index" data-index>
      <ul class="rows">
        {projects.map((p, i) => (
          <li class="row">
            <a href={`#project-${p.id}`} data-open={p.id} data-preview={i}>
              <span class="thumb" aria-hidden="true">
                {p.data.cover ? (
                  <Image src={p.data.cover} alt="" widths={[360, 640]} sizes="80vw" format="webp" quality={76} loading="lazy" />
                ) : (
                  <span class="thumb-art">
                    <span class="play"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M8 5.5v13l10.5-6.5z" /></svg></span>
                    <span class="thumb-label">{p.data.embedUrl ? 'Live 3D demo' : 'Live site'}</span>
                  </span>
                )}
              </span>
              <span class="num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <span class="title">{p.data.title}</span>
              <span class="when">{label(p)}</span>
              <span class="summary">{p.data.summary}</span>
              <span class="go" aria-hidden="true">
                View project
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
              </span>
            </a>
          </li>
        ))}
      </ul>

      <div class="preview" aria-hidden="true" data-preview-box>
        {projects.map((p, i) => (
          <div class="card" data-card={i}>
            {p.data.cover ? (
              <Image src={p.data.cover} alt="" widths={[480, 720]} sizes="420px" format="webp" quality={78} loading="lazy" class="shot" />
            ) : (
              <span class="shot art">
                <span class="play"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M8 5.5v13l10.5-6.5z" /></svg></span>
                <span class="art-title">{p.data.title}</span>
                <span class="thumb-label">{p.data.embedUrl ? 'Live 3D demo inside' : 'Live site'}</span>
              </span>
            )}
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .index { position: relative; }

  /* Phones and touch: a swipeable row of editorial cards. */
  .swipe-hint {
    display: flex; align-items: center; gap: 6px; margin: -12px 0 18px;
    color: var(--muted); font-size: var(--step-small); font-weight: 500;
  }
  .rows {
    list-style: none; margin: 0 calc(-1 * var(--gutter)); padding: 2px var(--gutter) 16px;
    display: grid; grid-auto-flow: column; grid-auto-columns: min(78%, 320px); gap: 18px;
    overflow-x: auto; overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory; scroll-padding-inline: var(--gutter);
    scrollbar-width: none;
  }
  .rows::-webkit-scrollbar { display: none; }
  .row { scroll-snap-align: start; display: grid; }
  .row a {
    display: grid; grid-template-columns: minmax(0, 1fr) auto; align-content: start; gap: 6px 12px;
    text-decoration: none; border-radius: 16px;
  }
  .thumb {
    grid-column: 1 / -1; position: relative; display: block; margin-bottom: 10px;
    aspect-ratio: 4 / 3; border-radius: 16px; overflow: hidden;
    background: var(--surface); box-shadow: inset 0 0 0 1px var(--line);
  }
  .thumb :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: top left; }
  .thumb-art {
    position: absolute; inset: 0; display: grid; place-items: center; align-content: center; gap: 12px;
    background: var(--ink); color: var(--bg);
  }
  .play {
    display: grid; place-items: center; width: 52px; height: 52px; border-radius: 50%;
    background: var(--orange); color: #fff;
  }
  .play svg { width: 22px; height: 22px; margin-left: 3px; }
  .thumb-label { font-size: 0.8125rem; font-weight: 500; letter-spacing: 0.12em; text-transform: uppercase; opacity: 0.8; }
  .num, .when {
    font-size: 0.75rem; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase;
    color: var(--muted); font-variant-numeric: tabular-nums;
  }
  .num { grid-row: 2; grid-column: 1; }
  .when { grid-row: 2; grid-column: 2; }
  .title {
    grid-column: 1 / -1;
    font-family: var(--font-display); font-weight: 500; letter-spacing: -0.025em; line-height: 1.15;
    font-size: 1.375rem; text-wrap: balance;
  }
  .summary {
    grid-column: 1 / -1; color: var(--muted); font-size: 0.9375rem; line-height: 1.5;
    display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
  }
  .go {
    grid-column: 1 / -1; display: inline-flex; align-items: center; gap: 6px; margin-top: 4px;
    font-weight: 600; font-size: 0.9375rem;
  }

  /* Wide screens: the typographic index. */
  @media (min-width: 900px) {
    .swipe-hint, .thumb, .go { display: none; }
    .rows { display: block; margin: 0; padding: 0; overflow: visible; }
    .row a {
      grid-template-columns: 4.5rem minmax(0, 1fr); align-items: baseline; gap: 6px 0;
      padding: clamp(20px, 2.4vw, 28px) 0; border-top: 1px solid var(--line); border-radius: 0;
    }
    .row:last-child a { border-bottom: 1px solid var(--line); }
    .num { grid-row: 1; grid-column: 1; font-size: 0.875rem; }
    .title {
      grid-row: 1; grid-column: 2;
      font-size: clamp(1.875rem, 1.1rem + 3.2vw, 3.75rem); letter-spacing: -0.035em; line-height: 1.04;
      transition: color 200ms ease-out;
    }
    .when, .summary { grid-column: 2; grid-row: auto; }
    .summary { display: block; font-size: inherit; line-height: inherit; max-width: 52ch; -webkit-line-clamp: unset; }
    .row a:hover .title, .row a:focus-visible .title { color: var(--orange); }
  }

  .preview { display: none; }

  /* Floating preview only where a real pointer can hover. */
  @media (min-width: 900px) and (hover: hover) and (pointer: fine) {
    .title, .summary { max-width: 56%; }
    .when { display: none; }
    .preview {
      display: block; position: absolute; right: 0; top: 0; width: 38%; aspect-ratio: 16 / 11;
      pointer-events: none; z-index: 2;
      transition: transform 360ms var(--ease-out);
    }
    .card {
      position: absolute; inset: 0; opacity: 0;
      transform: translateY(14px) scale(0.98);
      transition: opacity 200ms ease-out, transform 360ms var(--ease-out);
    }
    .card.on { opacity: 1; transform: none; }
    .card :global(.shot) {
      position: absolute; inset: 0; width: 100%; height: 100%;
      object-fit: cover; object-position: top left; border-radius: 18px;
      box-shadow: 0 24px 48px -20px color-mix(in srgb, var(--ink) 40%, transparent), 0 0 0 1px var(--line);
    }
    .art { background: var(--ink); color: var(--bg); display: grid; place-items: center; align-content: center; gap: 14px; }
    .art-title { font: 500 2rem/1 var(--font-display); letter-spacing: -0.03em; }
  }
</style>

<script>
  // Move the floating preview next to the hovered/focused row and show its card.
  document.querySelectorAll<HTMLElement>('[data-index]').forEach((index) => {
    const box = index.querySelector<HTMLElement>('[data-preview-box]');
    if (!box) return;
    const cards = [...box.querySelectorAll<HTMLElement>('[data-card]')];
    const show = (a: HTMLElement) => {
      const i = Number(a.dataset.preview);
      const row = a.closest('li') as HTMLElement;
      const maxTop = index.offsetHeight - box.offsetHeight;
      const top = Math.min(Math.max(row.offsetTop + row.offsetHeight / 2 - box.offsetHeight / 2, 0), Math.max(maxTop, 0));
      box.style.transform = `translateY(${top}px)`;
      cards.forEach((c, j) => c.classList.toggle('on', j === i));
    };
    const hide = () => cards.forEach((c) => c.classList.remove('on'));
    index.querySelectorAll<HTMLElement>('[data-preview]').forEach((a) => {
      a.addEventListener('mouseenter', () => show(a));
      a.addEventListener('focus', () => show(a));
    });
    index.addEventListener('mouseleave', hide);
    index.addEventListener('focusout', (e) => {
      if (!index.contains(e.relatedTarget as Node | null)) hide();
    });
  });
</script>
